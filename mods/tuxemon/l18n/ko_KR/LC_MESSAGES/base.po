msgid "tuxeball_hardened_description"
msgstr "턱시몬을 포획한다. 포획에 실패해도 부서지지 않는다."

msgid "tuxeball_hearty_description"
msgstr "포획하면 턱시몬이 좋아하는 맛이 든든한 맛으로 바뀐다."

msgid "tuxeball_peppy_description"
msgstr "포획하면 턱시몬이 좋아하는 맛이 톡 쏘는 맛으로 바뀐다."

msgid "tuxeball_refined_description"
msgstr "포획하면 턱시몬이 좋아하는 맛이 고급스러운 맛으로 바뀐다."

msgid "tuxeball_salty_description"
msgstr "포획하면 턱시몬이 좋아하는 맛이 짠맛으로 바뀐다."

msgid "tuxeball_zesty_description"
msgstr "포획하면 턱시몬이 좋아하는 맛이 상큼한 맛으로 바뀐다."

msgid "tuxeball_grand_description"
msgstr "호화 턱시볼보다도 포획률이 더 높다."

msgid "tuxeball_majestic_description"
msgstr "아무리 잡기 힘든 턱시몬이라도 잡을 수 있는 최고의 선택."

msgid "tuxeball_noble_description"
msgstr "일반 턱시볼을 적당히 개량한 것."

msgid "tuxeball_diurnal_description"
msgstr "낮에는 더 쉽게 포획하지만, 밤에는 효과가 크게 떨어진다."

msgid "tuxeball_nocturnal_description"
msgstr "밤에는 더 쉽게 포획하지만, 낮에는 효과가 크게 떨어진다."

msgid "tuxeball_gambler_description"
msgstr "예측할 수 없기로 유명한 턱시볼. 포획률이 들쭉날쭉해서 아주 낮을 때도, 엄청나게 높을 때도 있다."

msgid "boost_armour_description"
msgstr "이번 배틀 동안 방어를 2단계 올린다."

msgid "boost_dodge_description"
msgstr "이번 배틀 동안 회피를 2단계 올린다."

msgid "boost_melee_description"
msgstr "이번 배틀 동안 근접을 2단계 올린다."

msgid "boost_ranged_description"
msgstr "이번 배틀 동안 원거리를 2단계 올린다."

msgid "boost_speed_description"
msgstr "이번 배틀 동안 스피드를 2단계 올린다."

msgid "raise_armour_description"
msgstr "다이아몬드의 단단함을 배운다. 방어를 단련한다."

msgid "raise_dodge_description"
msgstr "오팔의 무지갯빛을 배운다. 회피를 단련한다."

msgid "raise_hp_description"
msgstr "석영의 크기와 풍부함을 배운다. 체력을 단련한다."

msgid "raise_melee_description"
msgstr "루비의 분노를 배운다. 근접을 단련한다."

msgid "raise_ranged_description"
msgstr "에메랄드의 조준을 배운다. 원거리를 단련한다."

msgid "raise_speed_description"
msgstr "스피넬의 반사 신경을 배운다. 스피드를 단련한다."

msgid "alpha_seep_description"
msgstr "영역 다툼이 절정에 달한 최상위 포식자의 냄새샘에서 채취한 걸쭉한 점액."

msgid "repellent_description"
msgstr "냄새 고약한 스프레이로 야생 턱시몬을 쫓아낸다."

msgid "fishing_rod_description"
msgstr "물고기를 낚는다."

msgid "poseidon_description"
msgstr "프로용 낚싯대."

msgid "neptune_description"
msgstr "고급 낚싯대."

msgid "hatchet_description"
msgstr "손도끼로 거추장스러운 통나무를 베어 낸다."

msgid "surfboard_description"
msgstr "엄마가 준 선물. 더 빨리 이동할 수 있다."

msgid "gold_pass_description"
msgstr "대성당의 고급 서비스를 누릴 수 있다."

msgid "dojo_pass_description"
msgstr "원소의 도장에 한 명 입장할 수 있다."

msgid "book_wishes_description"
msgstr "업적 마니아가 준, 도전해 볼 업적 목록."

msgid "earthmover_key_description"
msgstr "거대한 굴착기가 길을 막고 있다면 쓸모가 있을지도."

msgid "sledgehammer_description"
msgstr "회색 바위를 부순다."

msgid "shammer_fossil_description"
msgstr "고대 개의 두개골처럼 생겼지만, 돌처럼 단단하다."

msgid "rhincus_fossil_description"
msgstr "이빨 달린 새의 두개골처럼 생겼지만, 돌처럼 단단하다."

msgid "nu_phone_description"
msgstr "이걸로 할 수 있는 게 많다. 예를 들면 집에 전화하기."

msgid "bivouac_description"
msgstr "제대로 된 치료 센터에 온 것처럼 쉰다. 쓰면 사라진다."

msgid "drone_description"
msgstr "파티의 턱시몬 하나를 보관 중인 턱시몬과 바꾼다."

msgid "spyder_pass_description"
msgstr "스파이더 공모자만 들어갈 수 있는 곳에 들어갈 수 있을 것 같다."

msgid "app_radio_description"
msgstr "지역 방송, 퀘스트 소식, 각지의 이런저런 이야기를 들을 수 있다."

msgid "app_banking_description"
msgstr "마을에 있을 때 언제든 돈을 관리할 수 있다."

msgid "app_contacts_description"
msgstr "친구에게 전화하고, 원하는 사람과 배틀할 수 있다."

msgid "app_map_description"
msgstr "휴대폰으로 지금 어디에 있는지 확인한다."

msgid "app_renaming_description"
msgstr "턱시몬에게 새 이름을 지어 줘서 진짜 내 턱시몬으로 만들어 보자!"

msgid "app_tuxepedia_description"
msgstr "턱시몬 정보를 기록하고 세상과 공유한다."

msgid "p_trepidation_description"
msgstr "그림 「전율」, 캔버스에 유채. 작가 친필 서명."

msgid "p_starry_night_description"
msgstr "그림 「별이, 별이, 별이 빛나는 밤」, 캔버스에 유채. 작가 친필 서명."

msgid "p_monsters_eyes_description"
msgstr "그림 「몬스터의 눈이 마주칠 때」, 캔버스에 유채. 작가 친필 서명."

msgid "ancient_egg_description"
msgstr "기묘한 알. 땅에 심으면 부화할지도 모른다."

msgid "restoration_description"
msgstr "대상에게 걸린 상태를 모두 없앤다."

msgid "cureall_description"
msgstr "턱시몬의 체력을 가득 채우고 모든 상태를 없앤다."

msgid "escape_key_description"
msgstr "뒷문으로 슬쩍 빠져나간다."

msgid "unknown_object_description"
msgstr "출처도 용도도 알 수 없다. 쓰기 전에 감정을 받아야 한다."

msgid "bite_of_despair_description"
msgstr "냄새가 먼저 덮친다. 그리고 맛이 무자비하게 마무리한다."

msgid "whispersoup_description"
msgstr "국자가 떨리며 수프를 뜬다. 그다음 일어난 일은 아무도 말하지 않는다."

msgid "inferno_custard_description"
msgstr "먹기엔 너무 뜨겁고, 무시하기엔 너무 저주받았다. 그릇이 후회로 지글거린다."

msgid "dread_omelette_description"
msgstr "식감과 맛의 법칙을 거스른다. 식기마저 반항한다."

msgid "meal_dust_description"
msgstr "하늘 들판의 곡물을 달빛 아래에서 곱게 빻은 가루. 가볍고 쓰임새가 많아 굽거나 접거나 튀기는 요리에 빠질 수 없다."

msgid "sweetroot_description"
msgstr "속삭이는 숲 구덩이에서 캐낸 빛나는 덩이뿌리. 달고 순하며 은은한 시트러스 향이 있어 디저트나 새콤한 토핑에 딱 맞다."

msgid "mistflour_eggs_description"
msgstr "구름 위에 둥지를 트는 새가 낳은 신비한 알. 껍질이 말랑하고 마법의 공기가 가득해 요리를 꿈처럼 부풀리고 엉기게 한다."

msgid "suncrust_butter_description"
msgstr "햇살 꽃잎에서 짜낸 황금빛 크림. 따뜻하고 부드러우며 허브 향이 은은하다. 어떤 요리든 부드럽고 윤기 있고 풍성하게 만든다."

msgid "crackle_salt_description"
msgstr "메아리치는 동굴에서 캐낸 반짝이는 광물. 짭짤한 요리에 감칠맛과 반짝임을 더하고, 가끔 씹다가 톡 터진다!"

msgid "starpepper_description"
msgstr "별빛 아래에서만 익는 작고 빛나는 열매. 맵지만 달콤해서, 타는 듯하기보다 간질간질한 열기가 난다."

msgid "sky_feather_description"
msgstr "철새 같은 바람새가 이동을 마치고 털갈이할 때 뽑은 것. 섬세하고 가벼우며, 톡 쏘는 요리에 인기 만점인 바삭한 재료."

msgid "stonefruit_bulbs_description"
msgstr "화산 골짜기에서 자라는 든든한 뿌리 식물. 고기처럼 단단하고 버섯처럼 맛이 깊어 아주 배부르다."

msgid "field_greens_description"
msgstr "바람에 따라 색이 바뀌는 야생 잎. 산뜻하고 알싸하며 주로 생으로 먹거나, 살짝 말릴 만큼만 데워 먹는다."

msgid "beastmoss_description"
msgstr "고대 생물과 신성한 돌에 달라붙어 자라는 두툼한 이끼. 쫄깃하고 흙내음이 나서 바삭한 랩이나 든든한 파이에 제격이다."

msgid "glowfat_description"
msgstr "빛나는 덩굴이나 순한 짐승꽃에서 짜낸 기름. 비단 같은 질감에 버터 향이 난다. 요리나 윤기 내기에 쓴다."

msgid "moo_bloom_description"
msgstr "온순한 초원 짐승에게서 받은 우유 같은 꿀물. 부드럽고 포근하며 꿀풀과 설탕줄기 향이 난다."

msgid "zestsap_description"
msgstr "짜릿과일 나무에서 뽑은 전기 띤 시럽. 시트러스처럼 톡 쏘고 혀 위에서 살아 움직이는 듯하다. 밋밋한 맛을 깨우는 데 쓴다."

msgid "zestroot_wraps_description"
msgstr "먹을 수 있는 포장재로 쓰는 유연한 새싹. 탱탱하고 숨은 향신료가 배어 있어 부드럽게 접는 요리에 즐겨 쓴다."

msgid "root_beast_bark_description"
msgstr "갈비 모양으로 굳은 식물 조직을 길게 자른 것. 훈연 향과 섬유질, 원초적인 감칠맛이 있다. 육식가의 꿈처럼 양념했지만 식물성이다."

msgid "flamehorn_shank_description"
msgstr "불꽃뿔 식물에서 두툼하게 잘라 낸 살. 불꽃뿔은 지각이 없는 거대한 불 식물로, 구이용으로 재배한다. 진하고 그을린 맛에 씹는 맛이 좋다."

msgid "spice_dust_description"
msgstr "숨은 불기운과 짜릿과일 정수를 머금은 결정을 빻은 것. 혀 위에서 반짝이며 어떤 요리든 눈부시게 깨워 준다."

msgid "rub_pork_chops_description"
msgstr "뿌리짐승 껍질에 톡톡 가루를 입힌 것. 훈연 향에 맵고 강렬하다. 원초적인 고기처럼 양념했지만 순수 식물성이다."

msgid "mille_feuille_description"
msgstr "안개밀과 음매꽃 크림으로 만든 겹겹 페이스트리. 풍부하고 섬세하며 달콤함이 층층이 쌓였다."

msgid "cheesecake_description"
msgstr "빛나는 기름을 소용돌이처럼 두른 부드러운 음매꽃 케이크. 크리미하고 호화로우며 은은하게 반짝인다."

msgid "cream_puffs_description"
msgstr "마법 크림을 채운 단뿌리 슈. 가볍고 폭신하며 지독하게 맛있다."

msgid "crepes_description"
msgstr "반짝이는 속을 곡물 가루 크레이프로 감싼 것. 우아하고 달콤하며 살짝 알싸하다."

msgid "rub_steak_description"
msgstr "향신료 결정을 바른 불꽃뿔식 구이. 진하고 바싹 구워져 열기가 감돈다."

msgid "meatballs_description"
msgstr "돌과일 구근을 뭉친 볼에 상큼 수액 소스를 입힌 것. 든든하고 새콤하며 신기하게 배부르다."

msgid "shell_tacos_description"
msgstr "상큼뿌리 속과 음매꽃 소스를 넣은 들나물 랩 타코. 신선하고 탱탱하며 톡 쏜다."

msgid "potato_casserole_description"
msgstr "단뿌리와 안개밀을 겹겹이 쌓아 상큼 수액에 구운 것. 따뜻하고 상큼하며 부드럽게 씹힌다."

msgid "phyllo_description"
msgstr "새콤한 짐승 이끼를 채운 바삭한 랩. 섬세한 겹 속에 진한 흙내음이 있다."

msgid "croissants_description"
msgstr "상큼한 가루를 뿌린 햇빛 버터 크루아상. 바삭하고 노릇하며 살짝 찌릿하다."

msgid "rub_chicken_description"
msgstr "하늘 깃털 커틀릿에 별후추 양념을 바른 것. 가볍고 바삭하며 간이 세다."

msgid "heart_biscuit_description"
msgstr "딱 반으로 갈라지는 비스킷. 나눠 먹는 사람들의 마음을 따뜻하게 한다."

msgid "potato_fries_description"
msgstr "마법 소금을 뿌린 단뿌리 튀김. 바삭하고 빛나며 의외로 화끈하다."

msgid "pretzels_description"
msgstr "들판 곡물을 꼬아 만든 과자에 별후추를 살짝 더한 것. 짭짤하고 쫄깃하며 장난스럽게 맵다."

msgid "mashed_potatoes_description"
msgstr "톡톡 소금과 음매꽃 크림을 넣은 부드러운 뿌리 으깸. 포근한데 톡 쏘는 맛이 있다."

msgid "rub_ribs_description"
msgstr "톡톡 향신료를 입힌 돌과일 구근 립. 고기 같은 식감에 톡 터지는 재미가 있다."

msgid "pie_description"
msgstr "노릇한 파이 껍질 속에 짐승 이끼 스튜를 채운 것. 든든하고 바삭하며 맛이 깊다."

msgid "honey_cake_description"
msgstr "반짝이 가루를 넣은 촉촉한 단뿌리 케이크. 달콤하고 알싸하며 통통 튄다."

msgid "souffle_description"
msgstr "상큼 수액으로 부풀린 폭신한 빛나는 기름 수플레. 가볍고 새콤하며 혀 위에서 꿈처럼 녹는다."

msgid "hash_description"
msgstr "뿌리채소와 마법 허브를 볶은 따뜻한 해시. 흙내음 나는 편안함에 알싸한 한 방."

msgid "pita_description"
msgstr "상큼한 향신료 가루를 바른 바삭한 빵. 단순하고 바삭하며 맛이 꽉 찼다."

msgid "pastry_description"
msgstr "매콤한 단뿌리 소를 소용돌이처럼 채운 바삭한 페이스트리. 버터 향 겹 속에 폭죽 같은 속이 있다."

msgid "pudding_description"
msgstr "새콤하게 빛나는 크리미한 단뿌리 푸딩. 부드럽고 상큼하며 은은하게 반짝인다."

msgid "pancakes_description"
msgstr "반짝이 껍질을 얹은 폭신한 하늘곡물 케이크. 부드럽고 따뜻하며 즐겁게 화사하다."

msgid "wings_description"
msgstr "날짐승식으로 튀긴 바삭한 한입 거리. 마법의 매운맛이 난다. 진하고 지글지글, 한 입 크기의 용기."

msgid "mystery_analyzer_description"
msgstr "유물을 해독할 때마다 신나게 삑삑거리는 두툼한 스캐너."

msgid "buzz_resonator_description"
msgstr "곤충형 턱시몬의 진동과 벌집 신호를 감지한다."

msgid "pollen_decoder_description"
msgstr "자연과 얽힌 턱시몬에게서 생체 잔여물과 꽃가루를 읽어 낸다."

msgid "researcher_stylus_description"
msgstr "디지털 데이터 저장 장치와 고대 데이터 매체에 연결된다."

msgid "tachyon_collector_description"
msgstr "시간 조작으로 방출된 타키온을 포착하고 측정한다."

msgid "archeologist_sensor_description"
msgstr "희귀하고 신비한 유물의 에너지 신호를 감지한다."

msgid "starlight_lens_description"
msgstr "우주 속성 턱시몬과 관련된 천체 패턴을 포착한다."

msgid "field_transcriber_description"
msgstr "야생에서 발견한 것을 기록해 도감 이야기로 만든다."

msgid "encoded_chip_description"
msgstr "알 수 없는 기호와 비표준 코드가 새겨진 낡은 데이터 칩."

msgid "bio_sample_description"
msgstr "턱시몬 서식지에서 채취한 유기 입자. 반응성이 높고 불안정하다."

msgid "signal_node_description"
