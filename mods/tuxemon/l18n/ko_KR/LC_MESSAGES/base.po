msgid "scope_description"
msgstr "상대의 강점과 약점을 알아낸다."

msgid "shadow_blast_description"
msgstr "부정적인 에너지를 터뜨려 다른 존재의 생명력을 빨아들인다."

msgid "shadow_boxing_description"
msgstr "주먹을 연달아 퍼부어 상대를 때린다."

msgid "shapechange_description"
msgstr "순식간에 모습을 바꿔 뜻밖의 강력한 공격을 한다."

msgid "shooting_star_description"
msgstr "밤하늘을 가로지르는 별똥별의 에너지로 자신의 체력을 회복한다."

msgid "shrapnel_description"
msgstr "날카로운 파편을 퍼부어 넓은 범위에 피해를 준다."

msgid "shuriken_description"
msgstr "치명적인 수리검을 던진다. 맞힐 때마다 자신의 의지가 단단해진다."

msgid "sleep_bomb_description"
msgstr "수면 가루가 격렬하게 터져, 양쪽 모두 꾸벅꾸벅 졸게 될 수 있다."

msgid "sleeping_powder_description"
msgstr "잠이 오는 꽃가루 구름을 퍼뜨려 상대를 잠들게 한다."

msgid "slice_description"
msgstr "날카로운 칼날을 휘둘러 강력하게 벤다."

msgid "slime_description"
msgstr "끈적하고 걸쭉한 물질을 내뿜어 상대를 뒤덮고 피해를 준다."

msgid "snowball_description"
msgstr "단단하게 뭉친 눈덩이를 던져 약한 피해를 주고 살짝 얼린다."

msgid "snowstorm_description"
msgstr "눈보라가 상대를 휘감아 냉기 피해를 주고 탈진시킨다."

msgid "sockpuppet_description"
msgstr "자기 움직임을 따라 하는 엉뚱한 양말 인형을 꺼내 상대를 헷갈리게 하고, 몇 턴 동안 속임수와 상태 기술을 막는다."

msgid "solar_synthesis_description"
msgstr "햇빛을 흡수해 자신의 체력을 회복한다."

msgid "spiky_strike_description"
msgstr "날카로운 가시나 깃촉을 휘둘러 찌르는 공격을 연달아 퍼붓는다."

msgid "spit_poison_description"
msgstr "독주머니에서 죽음의 액체를 뿜는다."

msgid "splinter_description"
msgstr "나무 가시를 퍼부어 상대의 눈을 멀게 하고 피해를 준다."

msgid "stabilo_description"
msgstr "날카로운 나무 가시를 연달아 불러내 상대를 꿰뚫는다."

msgid "staff_smash_description"
msgstr "지팡이로 강력한 일격을 먹인다."

msgid "stampede_description"
msgstr "자신을 움직이게 하는 강력한 돌진."

msgid "starfall_description"
msgstr "천체가 비처럼 쏟아져 피해를 주고, 자신은 집중력을 높이며 상대는 탈진시킨다."

msgid "static_field_description"
msgstr "몸 주위에 정전기장을 만들어 방어를 높인다."

msgid "steel_jaws_description"
msgstr "금속으로 강화된 턱으로 꽉 문다. 강력한 물기 공격."

msgid "stick_description"
msgstr "막대기나 식물 줄기, 잔가지로 상대를 찌르거나 때린다."

msgid "sting_description"
msgstr "아프게 쏘아 상대의 몸에 독을 주입한다."

msgid "stone_rot_description"
msgstr "상대에게 빠르게 병이 찾아온다."

msgid "stonehenge_description"
msgstr "대지를 조종해 돌 고리를 만들어 상대를 짓누른다."

msgid "strangulation_description"
msgstr "상대의 목을 졸라 숨을 막는다."

msgid "strike_description"
msgstr "강력하게 집중된 일격을 날린다."

msgid "struggle_description"
msgstr "다른 방법이 없을 때 본능만으로 맞서 싸운다."

msgid "suck_poison_description"
msgstr "자기 몸의 독을 빨아내 적에게 옮긴다."

msgid "sudden_glow_description"
msgstr "찬란한 빛을 내뿜어 자신을 치유하고 기력을 되찾는다."

msgid "sunburst_description"
msgstr "태양의 에너지를 모아 눈부시게 밝은 공격을 한다."

msgid "supernova_description"
msgstr "엄청난 에너지 폭발로 모든 상대에게 막대한 피해를 준다."

msgid "suplex_description"
msgstr "상대를 붙잡아 땅에 내던지는 강력한 기술. 피해를 주고 자신은 더 단단해진다."

msgid "surf_description"
msgstr "거대한 파도가 상대를 덮친다."

msgid "surge_description"
msgstr "강력한 전기를 방출해 상대를 감전시킨다."

msgid "sylvan_description"
msgstr "자연의 힘을 불러 상대를 나무 인형으로 바꾼다."

msgid "tail_lash_description"
msgstr "꼬리나 꼬리 같은 부위를 채찍처럼 휘두른다."

msgid "take_cover_description"
msgstr "방어 자세를 취해 명중률을 높인다."

msgid "taunt_description"
msgstr "가볍게 찔러 상대를 강하지만 산만한 분노에 빠뜨린다."

msgid "ten_thousand_feathers_description"
msgstr "깃털이 쏟아져 상대를 여러 번 때린다."

msgid "terror_description"
msgstr "상대가 공포에 떨어 아이템을 줍거나 쓸 수 없다."

msgid "thorn_burst_description"
msgstr "날카로운 가시를 비처럼 퍼부어 상대에게 피해를 주고, 가시에 묶여 움직이지 못하게 할 수 있다."

msgid "thunderball_description"
msgstr "천둥 같은 굉음과 함께 단단한 바위 공이 상대를 때린다."

msgid "thunderclap_description"
msgstr "갑작스러운 귀청 찢는 천둥소리로 상대를 기절시키고 피해를 준다."

msgid "time_crisis_description"
msgstr "시간의 흐름을 비틀어 상대에게 피해를 준다."

msgid "tinder_description"
msgstr "상대에게 불을 붙인다."

msgid "tip_description"
msgstr "급소를 빠르고 정확하게 찌른다."

msgid "tonguespear_description"
msgstr "혀를 상대에게 찔러 넣어 피를 빨아들인다."

msgid "tooth_for_tooth_description"
msgstr "송곳니를 드러내고, 받은 고통을 그대로 돌려준다."

msgid "torch_description"
msgstr "상대를 맞히는 투사체."

msgid "tornado_description"
msgstr "소용돌이치는 공기를 불러 파괴적인 토네이도로 상대를 들어 올리고 피해를 준다."

msgid "trample_description"
msgstr "강력한 어깨 태클로 상대를 쓰러뜨리고 재빨리 물러나, 상대를 그 자리에 묶어 둔다."

msgid "tsunami_description"
msgstr "거대한 파도를 불러 상대를 덮친다."

msgid "tux_attack_description"
msgstr "데이터의 회오리로 변해 큰 피해를 준다."

msgid "ubuntu_description"
msgstr "혼돈의 에너지를 내뿜어 상대의 속성을 무작위로 바꾼다."

msgid "undertaker_description"
msgstr "자신의 체력을 희생해 막대한 피해를 주는 필사의 공격."

msgid "venomous_tentacle_description"
msgstr "독 촉수로 상대를 때려 피해를 주고 독에 빠뜨린다."

msgid "viper_description"
msgstr "날카로운 나무 화살을 엄청난 속도와 정확도로 연달아 쏜다."

msgid "vorpal_description"
msgstr "치명적이고 정밀한 일격으로 큰 피해를 주고, 상대를 불타는 복수심으로 채운다."

msgid "wall_fire_description"
msgstr "불의 벽을 불러내 자신을 지키고 상대를 그을린다."

msgid "wall_of_steel_description"
msgstr "빙글빙글 돌며 물어뜯는 강철 방벽을 만든다."

msgid "wallow_description"
msgstr "진흙탕에서 느긋하게 뒹굴며 상처를 치유한다."

msgid "walls_description"
msgstr "흙이나 바위로 튼튼한 벽을 쌓아 방어막을 만든다."

msgid "water_blast_description"
msgstr "강력한 물줄기를 터뜨려 상대에게 피해를 준다."

msgid "water_bullet_description"
msgstr "입에 머금은 물을 엄청난 속도로 상대에게 쏜다."

msgid "web_description"
msgstr "끈적한 거미줄을 쏘아 상대를 가두고 피해를 준다."

msgid "webs_wind_description"
msgstr "끈적한 거미줄 소용돌이로 상대를 옭아매 여러 번 공격하고 움직임을 느리게 한다."

msgid "whirlwind_description"
msgstr "강력한 바람 소용돌이로 상대를 휩쓸어 버린다."

msgid "wicked_wind_description"
msgstr "불길한 바람이 다가온다."

msgid "wiggle_description"
msgstr "몸을 이리저리 흔들어 우스꽝스럽게 시선을 끈다. 피해는 없지만 보는 재미는 있을지도."

msgid "wing_tip_description"
msgstr "날개 끝으로 날카롭게 벤다."

msgid "woodsmash_description"
msgstr "강력한 나무 일격으로 상대를 들이받아 피해를 주고, 뒤로 밀어낼 수 있다."


