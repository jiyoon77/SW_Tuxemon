msgid "potluck_description"
msgstr "자신과 상대가 선물을 주고받으며, 배틀 중에 잠깐 우정을 나눈다."

msgid "pouch_description"
msgstr "주머니나 가방에서 맛있는 간식을 꺼내 먹고 기운을 차린다."

msgid "power_theft_description"
msgstr "유전자 교환 같은 방법으로 힘을 훔쳐, 적의 속성으로 공격한다."

msgid "proboscis_description"
