msgid "eclipse_route7_arnold1"
msgstr "군도에서 새 턱시몬이 발견됐다는 얘기 들었어?"

msgid "eclipse_route7_sylvester1"
msgstr "바다는 여기서 한참 멀어."

msgid "eclipse_route7_fritz1"
msgstr "크리스털식 아침 식사는 보통 흰 소시지, 밀맥주, 프레첼이야."

msgid "eclipse_route7_statius1"
msgstr "자신에 대해 딱 하나 바꿀 수 있다면 뭘 바꾸고 싶어?"

msgid "eclipse_route7_statius2"
msgstr "아마 내 파티겠지, 몬스터 파티."

msgid "eclipse_route7_jacopo1"
msgstr "앱 하나 내려받을 생각 있어?"

msgid "eclipse_route7_jacopo2"
msgstr "좀비와 희생자를 짝지어 주는 앱이야."

msgid "eclipse_route7_pia1"
msgstr "정말 날 무시할 거야?"

msgid "eclipse_route7_pia2"
msgstr "이번 싸움에서 그런 일들이 있었는데?"

msgid "eclipse_route7_penitent1"
msgstr "초코칩 쿠키 냄새가 너무 좋아서 허락도 없이 하나 먹어 버렸어."

msgid "eclipse_route7_penitent2"
msgstr "제발, 아무한테도 말하지 마!"

msgid "eclipse_route7_nino1"
msgstr "산속 오솔길을 걸으며 자연의 평화를 즐겼어."

msgid "eclipse_route7_nino2"
msgstr "그렇게 평화롭진 않네!"

msgid "eclipse_route7_hugh1"
msgstr "담배 좀 피워도 될까?"

msgid "eclipse_route7_hugh2"
msgstr "어떻게 끊지?"

msgid "eclipse_route7_arnaut1"
msgstr "열등감의 나쁜 점은 엉뚱한 사람들이 갖고 있다는 거야."

msgid "eclipse_route7_arnaut2"
msgstr "이런!"

msgid "eclipse_route7_conrad1"
msgstr "라이언 마운틴에 눈이 와서 관광객들이 다 신났어."

msgid "eclipse_route7_conrad2"
msgstr "관광객이 너무 많아."

msgid "eclipse_route7_manfred1"
msgstr "우리 삶이 다시 평범해질 날이 올까?"

msgid "eclipse_route7_manfred2"
msgstr "그러니까... 코튼 타운 일 이후에 말이야."

msgid "eclipse_route7_sordello1"
msgstr "원하는 걸 뭐든 살 수 있다면 뭘 살 거야?"

msgid "eclipse_route7_sordello2"
msgstr "아마 부활초 몇 개랑 물약 좀."

msgid "eclipse_crystal_alert_skating"
msgstr "늘 조심하세요! 안전 장비를 꼭 챙기세요!"

msgid "eclipse_crystal_hackerchat"
msgstr "2주 전에 ${{map_name}}에 엄청난 눈보라가 몰아쳤어."

msgid "eclipse_crystal_barmaid"
msgstr "난 스케이트를 잘 못 타."

msgid "eclipse_crystal_grannypiper"
msgstr "대눈보라의 피해가 워낙 커서, 지금도 생존자들이 모여 추모한단다."

msgid "eclipse_crystal_monk"
msgstr "눈보라에 친구를 잃었던 때가 떠오르네."

msgid "eclipse_crystal_granny"
msgstr "그건, 어... 무거운 얘기네. 안됐구나."

msgid "eclipse_crystal_shopkeeper"
msgstr "우린 산을 숭배하고 깊이 존경해. 무슨 일이 닥치든 산이 우릴 구해 줄 거라 믿어."

msgid "eclipse_crystal_maniac"
msgstr "등반가들은 정신 차리고 라이언 마운틴 등반이 극도로 위험하다는 걸 알아야 해.\n강한 턱시몬이 있다고 오를 수 있다고 믿는 건 그만둬야 해."

msgid "eclipse_crystal_beck"
msgstr "그건 하나도 안 웃겨, 친구."

msgid "eclipse_crystal_tvwatch"
msgstr "한 기자가 사라진 문명을 찾아 세계를 누빈다."

