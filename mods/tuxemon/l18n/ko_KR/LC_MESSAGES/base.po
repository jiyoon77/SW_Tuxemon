msgid "quicksand_description"
msgstr "위험한 유사 지대를 만들어 상대를 가두고 피해를 준다."

msgid "radiance_description"
msgstr "눈부신 섬광을 터뜨린 뒤 강력한 에너지 폭발을 날린다."

msgid "ram_description"
msgstr "엄청난 힘으로 돌진해 파괴적인 몸통 박치기를 먹인다."

msgid "refresh_description"
msgstr "기운을 되살려 체력을 회복하고, 빠르게 회복하는 상태가 된다."

msgid "revenge_stance_description"
