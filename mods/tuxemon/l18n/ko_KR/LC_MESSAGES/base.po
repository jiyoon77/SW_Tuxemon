msgstr "모습을 바꾸면서 자신을 치유하고 상대를 혼란에 빠뜨린다."

msgid "depth_charge_description"
msgstr "물속으로 잠수했다가 위로 폭발하듯 솟구쳐 상대에게 피해를 준다."

msgid "diet_description"
msgstr "건강한 음식으로 몸을 채워 체력을 단련하고 피해에 강해진다."

msgid "divinity_beam_description"
msgstr "신성한 빛줄기가 바라보는 자의 눈을 멀게 한다."

msgid "dreamwalk_description"
msgstr "잠든 상대의 꿈속에 들어가 피해를 줄 수 있다."

msgid "earthquake_description"
msgstr "강력한 땅 공격으로 대지를 격렬하게 뒤흔든다."

msgid "egg_smash_description"
msgstr "알이나 알 조각을 던져, 지저분하고 정신없는 일격을 먹인다."

msgid "electric_multibite_description"
msgstr "전기를 흘리며 여러 번 문다. 상대를 감전시킬 수 있다."

msgid "electrical_storm_description"
msgstr "거센 뇌우를 불러 번개로 상대를 내리친다."

msgid "electroplate_description"
msgstr "전기로 상대를 금속으로 도금해 속성을 바꾼다."

msgid "energy_beam_description"
msgstr "길 위의 모든 것을 태우는 에너지 광선을 쏜다."

msgid "energy_claws_description"
msgstr "발톱에 에너지를 실어 강력하게 집중된 공격을 날린다."

msgid "energy_field_description"
msgstr "장치가 상대의 에너지를 빨아들여 자신을 강화한다."

msgid "entomb_description"
msgstr "엄청난 힘으로 상대를 땅에 짓누르고 그 주위에 무덤을 쌓는다."

msgid "evasion_description"
msgstr "몸이 흐릿하게 보일 만큼 빠르게 움직여 원거리 공격을 맞히기 어려워진다."

msgid "external_power_description"
msgstr "여러 속성이 될 수 있는 원거리 공격을 한다."

msgid "eyebite_description"
msgstr "눈길 한 번으로 상대의 기운과 활력을 빼앗는다."

msgid "feint_description"
msgstr "공격하는 척하다가 재빨리 기습한다."

msgid "feline_description"
msgstr "사냥 본능에 집중한다."

msgid "fester_description"
msgstr "고약한 냄새가 전장을 뒤덮어 모두의 회복을 방해한다."

msgid "fiery_description"
msgstr "강력한 불꽃을 내뿜어 상대의 속성을 불로 바꾼다."

msgid "fire_ball_description"
msgstr "타오르는 불덩이를 상대에게 던진다."

msgid "fire_claw_description"
msgstr "발톱에 불을 붙여 태우는 공격을 한다."

msgid "fire_shield_description"
msgstr "몸 주위에 불의 벽을 둘러 자신을 지키고, 상대를 태운다."

msgid "firestorm_description"
msgstr "거센 불길을 일으켜 상대를 집어삼킨다."

msgid "flamethrower_description"
msgstr "강렬한 불길을 상대에게 내뿜는다."

msgid "fledgling_description"
msgstr "날카로운 깃털을 상대에게 날린다."

msgid "flood_description"
msgstr "거센 홍수를 불러 상대를 휩쓴다."

msgid "flow_description"
msgstr "강력한 물줄기를 뿜어낸다."

msgid "flower_armor_description"
msgstr "꽃으로 갑옷을 만든다."

msgid "flower_bloom_description"
msgstr "피하기 어려운 거대한 꽃잎 폭풍이 눈보라처럼 들판을 휩쓴다."

msgid "fluff_up_description"
msgstr "몸을 부풀려 상처를 치유한다."

msgid "font_description"
msgstr "신비한 샘에서 에너지를 끌어와 자신을 치유한다."

msgid "food_fight_description"
msgstr "정신없는 음식 싸움을 시작해, 먹을 것을 마구잡이로 상대에게 던진다."

msgid "frighten_description"
msgstr "겁먹은 상대가 높은 곳으로 피해, 원거리 공격은 잘 맞지만 근접 공격은 약해진다."

msgid "frostbite_description"
msgstr "얼어붙는 냉기를 쏘아 상대를 독에 빠뜨린다."

msgid "fume_description"
msgstr "분노에 휩싸인다."

msgid "fungal_spore_description"
msgstr "닿으면 포자가 터져 나온다. 낮은 확률로 상대를 감염시켜 생명력을 빨아들인다."

msgid "geyser_description"
msgstr "강력한 물기둥을 뿜어 상대의 속성을 물로 바꾼다."

msgid "give_all_description"
msgstr "자신을 희생한다."

msgid "glower_description"
msgstr "자신이 노려보면 상대가 약해지고 무방비해진다."

msgid "gnaw_description"
msgstr "상대를 갉아 작은 피해를 준다. 약하지만 빠르고 꾸준한 공격."

msgid "goad_description"
msgstr "상대를 도발해 분노하게 만든다."

msgid "gold_digger_description"
msgstr "땅을 파서 보물을 찾거나, 자기 자신을 공격하고 만다."

msgid "gourmet_description"
msgstr "영양가 있는 식사를 해치워 활력을 되찾고 기운을 북돋운다."

msgid "greenstone_description"
msgstr "떨어지는 돌 같은 힘으로 공격한다."

msgid "grinding_description"
msgstr "갈아 버리듯 끈질기게 연타를 퍼부어 상대를 서서히 지치게 한다."

msgid "gust_description"
msgstr "강한 바람을 일으켜 상대를 날려 보낸다."

msgid "hallucinogen_spore_description"
msgstr "환각 포자 구름을 퍼뜨려 상대의 방향 감각과 현실 인식을 흐트러뜨린다."

msgid "hammerhead_description"
msgstr "앞으로 돌진해 머리로 상대를 들이받는다."

msgid "harpoon_description"
msgstr "흰고래도 잡을 수 있는 정확한 작살."

msgid "hawk_description"
msgstr "하늘 높이 날아올랐다가 강력하게 내리꽂는다."

msgid "healing_herb_description"
msgstr "치유의 잎을 건네 동료를 치료한다."

msgid "heavenly_desserts_description"
msgstr "너무 맛있어서 회복도 되고 천국에 간 기분도 드는 기묘한 기술."

msgid "hibernate_description"
msgstr "회복을 위한 깊은 잠에 빠진다."

msgid "hook_description"
msgstr "뿔이나 팔다리로 상대를 걸어 잡으려 한다."

msgid "horn_description"
msgstr "뿔로 세게 찌르지만 마구잡이라 자주 빗나간다."

msgid "ice_claw_description"
msgstr "발톱을 얼음으로 덮어 얼어붙는 공격을 한다."

msgid "ice_shield_description"
msgstr "몸 주위에 얼음 벽을 둘러 자신을 지키고, 상대를 느리게 한다."

msgid "ice_storm_description"
msgstr "상대를 얼어붙는 기운으로 감싸 위험한 환경을 만든다."

msgid "icicle_spear_description"
msgstr "날카로운 얼음 조각을 상대에게 연달아 쏜다."

msgid "implosion_description"
msgstr "자신과 상대를 함께 날려 버리려 한다."

msgid "infectious_bite_description"
msgstr "곪게 하는 독을 주입하는 빠르고 날카로운 물기. 상대에게 오래가는 상처를 남길 수 있다."

msgid "inner_power_description"
msgstr "내면의 힘을 끌어내 같은 속성의 공격을 한다."

msgid "insanity_description"
msgstr "분노에 사로잡혀 힘이 강해진다."

msgid "invictus_description"
msgstr "광전사 상태가 되어 끈질기게 맹공하며 상대를 가둔다."

msgid "just_desserts_description"
msgstr "독이 든 간식을 상대에게 건네, 독에 쓰러지는 모습으로 달콤한 복수를 한다."

msgid "kindling_flame_description"
msgstr "내면의 불을 지펴 공격력을 높인다."

msgid "kiss_description"
msgstr "입맞춤으로 체력을 서로 주고받는다."

msgid "kraken_description"
msgstr "전설의 바다 괴물의 힘을 불러 파괴적인 공격을 한다."

msgid "lantern_description"
msgstr "밝은 빛으로 상대에게 피해를 준다."

msgid "laser_beam_description"
msgstr "빛의 속도로 날아가는 강력한 원거리 에너지 공격. 상대의 눈을 멀게 할 수 있다."

msgid "lava_description"
msgstr "녹은 용암을 뿜어 자신과 상대를 함께 태운다."

msgid "leaf_barrage_description"
msgstr "잎사귀를 연달아 상대에게 퍼붓는다."

msgid "leaf_stab_description"
msgstr "가시 돋친 날카로운 잎을 던진다. 찔린 상처에서 피가 나며 화끈거린다."

msgid "levitate_description"
msgstr "모두가 공중에 떠올라 유리한 위치를 얻지만, 맨손 공격은 서로 맞히기 어려워진다."

msgid "lick_lash_description"
msgstr "혀를 채찍처럼 휘둘러 피해를 주고, 상대를 기절시킬 수 있다."

msgid "life_surge_description"
msgstr "생명력이 폭발해 몬스터를 채우지만, 대신 상대도 회복시킨다."

msgid "lightning_spheres_description"
msgstr "전기 구체 여러 개를 상대에게 날린다."

msgid "lineage_description"
msgstr "조상의 힘을 끌어내 공격한다."

msgid "lock_horns_description"
msgstr "적과 뿔을 맞대려 한다."

msgid "lust_description"
msgstr "매력을 이용해 상대의 방어를 약하게 만든다."

msgid "magic_spell_description"
msgstr "상대의 원거리가 아닌 기술의 재사용 대기 시간을 늘리려 한다."

msgid "magma_description"
msgstr "녹은 바위를 쏟아낸다."

msgid "magnetic_body_description"
msgstr "강력한 자기장을 만들어 쇠붙이를 전장에 마구 날려 상대의 움직임을 방해한다."

msgid "meltdown_description"
msgstr "부식성 공격으로 상대에게 피해를 준다."

msgid "mending_description"
msgstr "주변에서 에너지를 끌어와 자신을 치유한다."

msgid "midnight_mantle_description"
msgstr "어둠의 망토를 두르고, 그림자 촉수로 상대에게 피해를 주고 혼란에 빠뜨린다."

msgid "mind_explosion_description"
msgstr "강력한 초능력, 혹은 버섯 환각 공격."

msgid "mind_vise_description"
msgstr "상대의 정신을 붙잡아 움직이지 못하게 한다."


# 04B_TECH ##
msgid "mobbing_description"
msgstr "몸에서 작은 생물 떼가 쏟아져 나와 연이은 공격으로 상대를 압도한다."

msgid "muck_description"
msgstr "끈적한 독성 물질로 상대를 뒤덮는다."

msgid "muddle_description"
msgstr "전장에 아지랑이가 끼어 공격이 맞기 어려워진다."

msgid "mudslide_description"
msgstr "거대한 산사태를 일으켜 상대를 집어삼킨다."

msgid "mystic_blending_description"
msgstr "주변과 하나가 되어 자신을 치유한다."

msgid "needle_description"
msgstr "바늘이나 가시로 상대를 빠르게 찌른다."

msgid "negation_description"
msgstr "상대의 회복 효과를 무효로 만든다."

msgid "nest_description"
msgstr "몸 주위에 보호용 둥지를 짓는다."

msgid "neutralize_description"
msgstr "전장을 초기화해 모든 상태와 변화를 없앤다."

msgid "oedipus_description"
msgstr "복수심에 불타 공격하며 상대를 혼란에 빠뜨린다."

msgid "one_million_talons_description"
msgstr "면도날처럼 날카로운 공격을 빠르게 퍼붓는다."

msgid "one_two_description"
