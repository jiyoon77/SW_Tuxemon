msgid "aardart_description"
msgstr "지금까지 먹은 개미 수를 하나하나 세고, 기념할 만한 숫자가 되면 축하한다."

msgid "aardorn_description"
msgstr "태어나면 개미집 속에 놓이고, 먹으면서 스스로 길을 뚫고 나와야 한다."

msgid "abesnaki_description"
msgstr "얼굴마다 무늬가 다르며, 그 기호가 사라진 언어의 단어를 이룬다는 말도 있다."

msgid "agnidon_description"
msgstr "네 발로 다니는 걸 좋아하지만, 문을 열거나 나무를 넘어뜨리거나 물건을 들 때는 두 발로 선다."

msgid "agnigon_description"
msgstr "드래곤처럼 보이지만 실제로는 다른 계통의 고대 파충류에서 진화해서 '가짜 드래곤'이라 불린다."

msgid "agnite_description"
msgstr "장난기가 많지만, 어릴 때부터 불을 조절하는 법을 가르쳐야 한다."

msgid "allagon_description"
msgstr "알라곤은 조상이 남긴 금속으로 만든 유물에 끌리며, 그것을 되찾으려고 난폭해진다."

msgid "altie_description"
msgstr "알티는 거품을 타고 땅으로 내려왔다. 거품이 터진 지금은 공중으로 몇 미터 이상 떠오르지 못한다."

msgid "ambuwl_description"
msgstr "주머니 속 알은 부화하지 않는다. 대신 회복력이 있는 맛있는 음료를 분비한다."

msgid "ampystoma_description"
msgstr "암피스토마의 눈에 띄는 경고색으로는 매복이 불가능할 것 같지만, 사냥터인 탁한 물이 정체를 드러낼 때까지 몸을 숨겨 준다. 뇌우가 칠 때 땅 위로 나오는 걸 좋아한다."

msgid "angesnow_description"
msgstr "얼음 같은 험지에서 길을 잃었다가 살아 돌아온 사람들은, 눈보라로 앞이 안 보일 때도 신비한 존재가 길을 안내했다고 말하곤 한다."

msgid "angrito_description"
msgstr "인간이 왜 분노와 증오를 느끼는지 이해하지 못하지만, 앵그리토도 그런 충동을 느낀다."

msgid "anoleaf_description"
msgstr "자기 근처에서 자라는 식물을 형제자매로 여긴다."

msgid "anu_description"
msgstr "잃어버린 사랑을 찾으려고 다른 이의 꿈속에 들어간다고 한다."

msgid "apeoro_description"
msgstr "옛 왕들은 초능력으로 자기 영혼을 이 황금 계산 기계에 옮겼다. 지금도 살아 있지만, 말은 못 한 채 제국을 꿈꾸고 있다."

msgid "araignee_description"
msgstr "모든 거미는 다리가 여덟 개라고 우기는 사람들도 아레녜 앞에서는 이상하게 조용해진다."

msgid "arthrobolt_description"
msgstr "동료인 넛과 볼트에게 명령하는 게 불편해서 대개 도망친다. 그러면 넛과 볼트는 지시해 줄 이가 없어진다."

msgid "askylpaws_description"
msgstr "재앙의 징조로, 큰 어려움이 닥칠 때 자주 나타난다. 그래서 불행의 원인으로 오해받기도 한다."

msgid "asudopt_description"
msgstr "전설에 따르면 아수돕트가 세상을 만들었고, 언젠가 세상을 멸망시킨다. 그때까지는 세상의 보편 법칙을 정한다."

msgid "av8r_description"
msgstr "해가 떠 있으면 원하는 만큼 멀리, 높이 날 수 있다."

msgid "axolightl_description"
msgstr "꼬리로 깊은 물을 밝혀 물고기에게 안전한 쉼터를 알려 준다."

msgid "b_ver_1_description"
msgstr "로봇에게 물려야 할 일이 있을 때를 위해 설계되었다."

msgid "babysnitch_description"
msgstr "씩씩대는 베이비스니치는 공격에 몸을 던지지만, 대개 별 효과가 없다. 하지만 조심해라. 그 모습을 비웃으면 배드스크래치로 자란 뒤 너를 사냥하러 올 것이다."

msgid "baddrscratch_description"
msgstr "격노한 배드스크래치는 무시무시한 사냥꾼으로, 죽음이 눈앞에 닥쳐도 사냥감을 쫓는 걸 멈추지 않는다."

msgid "bamboon_description"
msgstr "대나무 지팡이로 싸우며, 균형을 잡는 데도 쓴다."

msgid "banling_description"
msgstr "밴링은 저마다 갈 곳 없는 영혼이 가지에 깃들기를 기다리고 있다."

msgid "bansaken_description"
msgstr "해 질 녘이 되면 밴사켄 속 영혼들이 깨어난다. 늦게까지 안 자는 말썽꾸러기 아이를 자기 무리에 더하는 걸 좋아한다."

msgid "banvengeance_description"
msgstr "밴벤전스는 뻗어 나가는 뿌리에서 새 나무를 키워 빛을 가리고, 경쟁하는 식물을 질식시켜 자기만의 밤을 만든다."

msgid "baobaraffe_description"
msgstr "거대한 몸에 엄청난 양의 물을 저장해 뜨겁고 메마른 사막을 멀리까지 건넌다. 목마른 생물에게 물을 나눠 주기도 한다. 저장한 물이 없으면 홀쭉하다."

msgid "baoby_description"
msgstr "마실 물과 저장할 물을 찾아 강에서 강으로 옮겨 다닌다. 머리의 잎사귀 뿔 속에 움직이는 끝이 숨어 있어 수맥 막대처럼 쓰인다. 가뭄 때는 많은 생물이 바오비를 따라다닌다."

msgid "bedoo_description"
msgstr "먹잇감을 통째로 삼켜 몇 시간 동안 깊이 재우고, 그동안 꿈을 먹는다. 실수로 영원히 잠들게 하는 일도 잦다."

msgid "beenstalker_description"
msgstr "빈스토커는 눈치와 우아함은 부족해도 넘치는 열정과 선의로 그걸 메운다. 해로운 동물을 쫓아내는 걸 즐기지만, 절대 해치지는 않는다."

msgid "bewhich_description"
msgstr "비위치가 숨을 참으면 아름답지만 어딘가 불길한 인간처럼 보인다."

msgid "bigfin_description"
msgstr "등 위에 생태계가 통째로 있어서 물속으로 들어가지 않으려고 한다."

msgid "birdee_description"
msgstr "잡식성이지만, 고기를 좋아할지 씨앗을 좋아할지는 어릴 때의 경험에 따라 달라진다."

msgid "birdling_description"
msgstr "모르는 사람은 자기 알을 등에 지고 다닌다고 생각한다. 사실 그보다 훨씬 중요한 알을 지키고 있다."

msgid "bishosand_description"
msgstr "비쇼샌드는 종교적·영적 상징에 매료되어 모으는 걸 좋아하지만, 그 뜻은 하나도 이해하지 못한다고 한다."

msgid "blasdoor_description"
msgstr "블래스도어는 아끼는 이를 뚫을 수 없는 몸 뒤에 숨겨 주지만, 반갑지 않은 침입자와 고철 기계는 강철 이빨로 잘게 부숴 버린다."

msgid "bolt_description"
msgstr "볼트가 곁에 있으면 넛은 더 세게 조이고 더 많은 에너지를 뿜는다."

msgid "boltnu_description"
msgstr "대부분의 시간을 땅에 굴을 파며 보낸다. 흙을 파면서 생기는 끊임없는 진동과 움직임 때문에 늘 어지럽다."

msgid "botbot_description"
msgstr "어떤 용도로든 바꿔 쓸 수 있는 만능 로봇이다."

msgid "boxali_description"
msgstr "긴 파란 망토로 땅 위를 활공할 수 있어 묘기와 공중 공격을 펼친다."

msgid "boxorox_description"
msgstr "멍청해질수록 바위 몸이 더 단단해진다."

msgid "brachifor_description"
msgstr "브래키포는 꼼짝 않고 있으면 먹지 않고도 지낼 수 있다."

msgid "breem_description"
msgstr "밤에는 과일에 구멍을 뚫어 새 더곳을 넣는다. 낮에는 평범한 벌인 척한다."

msgid "brewdin_description"
msgstr "한때 귀했지만 방치된 도자기 같은 보물에서 태어난다. 자기를 웃게 해 주는 사람의 소원을 들어준다는 소문이 있다."

msgid "bricgard_description"
msgstr "겨울이 오면 임브리크실은 포식자로부터 몸을 지키려고 벽돌로 방어용 고치를 짓는다."

msgid "brickhemoth_description"
msgstr "브릭가드의 둥지를 걷어찰 때는 조심해라. 브리키머스로 완성된 턱시몬은 충격을 신호 삼아 튀어나온다."

msgid "brumi_description"
msgstr "방치된 빗자루는 브루미가 훔쳐 갈지도 모른다."

msgid "budaye_description"
msgstr "격려하는 듯한 울음소리와 손짓만으로 어떤 무리든 모두를 위해 힘을 합치게 만든다."

msgid "bugnin_description"
msgstr "그 칼은 사실 칼로 쓰려고 길러서 부러뜨린 더듬이다."

msgid "bumbulus_description"
msgstr "범불러스는 연기를 내뿜어 구름으로 변장하는 비행 생물이다. 진짜 몸을 본 사람은 아무도 없다."

msgid "burrlock_description"
msgstr "버록은 지나가는 이에게 달라붙어 여기저기 퍼지는 걸 좋아한다."

msgid "bursa_description"
msgstr "불은 하찮다며 거부하고, 오직 정신의 불만 만들어 낸다."

msgid "cacaburr_description"
msgstr "카카버는 텀블비 같은 꽃가루 매개자와 치카디 같은 씨앗 애호가를 많이 먹여 살린다."

msgid "cackleen_description"
msgstr "캐클린이 무언가에 씐 아이라는 사람도 있고, 길 잃은 소녀의 영혼이라는 사람도 있다."

msgid "cairfrey_description"
msgstr "어느 날 아침 깨어나 탐험을 떠나기로 한 유쾌한 가구."

msgid "caper_description"
msgstr "케이퍼는 얼음처럼 차가운 산골짜기 강의 물거품 속에서 서로 뛰놀며 장난친다."

msgid "capinyah_description"
msgstr "정글에서 통나무와 강바위를 들어 올리는 혹독한 훈련을 거쳐야만 카피티가 카피냐로 거듭날 수 있다."

msgid "capiti_description"
msgstr "아기처럼 보이지만, 수백 살 된 개체가 발견되기도 했다."

msgid "carcharock_description"
msgstr "카카록의 고대 본능은 현대 세계와 맞지 않는다. 고향의 익숙한 소리 대신 이제는 파판의 냄새와 팬서러피라의 포효가 들린다."

msgid "cardiling_description"
msgstr "불을 뿜을 거라곤 아무도 예상하지 못한다. 실제로 뿜기 전까지는."

msgid "cardinale_description"
msgstr "모든 포식자를 격렬하게 증오하며, 기회만 되면 그들과 새끼들에게 전쟁을 건다."

msgid "cardiwing_description"
msgstr "노랫소리가 훌륭하지만, 폭발하는 노래새를 기르려는 사람은 드물다."

msgid "cataspike_description"
msgstr "보고 배우며 싸우는 법을 익힌다. 내버려 두면 가시로 쓰레기를 줍는다."

msgid "cateye_description"
msgstr "여름의 끝을 기리며 1년에 한 번 눈을 깜빡인다고 한다."

msgid "chenipode_description"
msgstr "어딘가로 가고 싶을 때 신발 끈이나 바짓가랑이를 문다."

msgid "cherubat_description"
msgstr "호기심 많은 이 박쥐는 사랑에 빠진 사람들의 들뜬 감정에 끌려, 아무도 지키지 않는 꽃다발과 초콜릿 상자를 가져가 둥지를 짓는다."

msgid "chibiro_description"
msgstr "숲과 들판에 살며, 순무로 착각받는 일이 잦다."

msgid "chickadee_description"
msgstr "치카디는 느끼는 위험이 덜할수록 '디' 소리를 더 길게 반복해서 운다."

msgid "chillimp_description"
msgstr "눈 덮인 산꼭대기에 산다는 소문이 있지만, 제대로 찍힌 사진은 한 장도 없다."

msgid "chloragon_description"
msgstr "고대의 알을 비옥한 흙에 심으면 부화한다. 알이 다 떨어지면 클로라곤도 더는 없을 것이다."

msgid "chromeye_description"
msgstr "크로마이는 인간이 어떻게 생각하고 느끼는지 관찰하고 배우려고 만들어졌다."

msgid "claymorior_description"
msgstr "천 명 중 단 한 명만이 리갈랜스가 되어 클레이모리어를 다스릴 수 있다고 한다."

msgid "coaldiak_description"
msgstr "이 곰은 어디에든 불을 지르고, 무엇에서든 피를 뽑아낼 수 있다."

msgid "cobarett_description"
msgstr "짙게 피어오르는 연기로 몸을 감싸 우거진 덤불 사이를 쉽게 미끄러져 다닌다. 연기의 근원은 녹아내릴 듯한 체온으로, 너무 뜨거워서 입에서 불길이 솟는다."

msgid "cochini_description"
msgstr "세 살배기 아이만큼 똑똑하고 눈치가 빠르다. 맛도 좋다."

msgid "cocrune_description"
msgstr "어느 쪽으로 돌아도 핏빛 눈은 늘 너를 향한다."

msgid "cohldrabi_description"
msgstr "춥고 눈 많은 지역의 땅속에서 태어나 몇 주 만에 나는 법을 배운다."

msgid "coleorus_description"
msgstr "수백만 년 동안 변하지 않은 모습 그대로 존재해 왔다."

msgid "conglolem_description"
msgstr "젤은 오래전에 말라 버렸지만, 콩글로렘은 여전히 움직인다."

msgid "conifrost_description"
msgstr "재채기를 하면 눈사태가 난다. 콧물을 늘 훌쩍인다."

msgid "conileaf_description"
msgstr "주머니 잎에 넣은 음식은 섞이고 절여진다. 음식을 상하지 않게 보관하는 데 쓰인다."

msgid "coppi_description"
msgstr "코피의 꽃은 의외로 쓰고 냄새가 나지만, 맥주 양조와 약에 유용하다."

msgid "coproblight_description"
msgstr "선사 시대 턱시몬의 똥에서 태어났으며, 몸속 뼛조각을 방어에 썼다."

msgid "corvix_description"
msgstr "희생자의 뼛조각으로 날개를 무장한다."

msgid "cowpignon_description"
msgstr "말려서 약용 보양식으로 먹는 사람도 있다."

msgid "crankus_description"
msgstr "봄에 눈이 녹을 때까지 끝나지 않는 말다툼을 하며, 크랭커스가 산꼭대기에서 산꼭대기로 매애 울어 대는 소리가 들린다."

msgid "criniotherme_description"
msgstr "갈기는 낮에는 빛나고, 해 질 녘에는 크고 붉게 자라며, 밤에는 재가 되어 날아간다."

msgid "crustagu_description"
msgstr "물속 군락을 위협하는 자를 쫓아내려고 집게에서 꿰뚫는 독가시를 쏜다."

msgid "dandicub_description"
msgstr "한배 새끼가 태어나면 세상 곳곳으로 날아가 다시는 가족을 만나지 못한다."

msgid "dandylion_description"
msgstr "평생 한 번만 새끼를 낳는다. 그 뒤로는 새끼들을 찾아 세상을 떠돈다."

msgid "dankush_description"
msgstr "단쿠시는 숨을 참으면 몸이 타는 걸 막을 수 있으며, 그러면 잎마다 연기가 뭉게뭉게 피어오른다."

msgid "delfeco_description"
msgstr "델페코는 유선형 몸으로 물속을 재빠르게 누비며, 복잡한 사냥 전략에서 지능이 드러난다. 덩치는 크지만 장난기가 많고 트레이너와의 유대가 강하다."

msgid "demosnow_description"
msgstr "데모스노는 영광과 모험을 약속하며 여행자를 안전한 선을 넘어 황야 깊숙이 꾀어내는 걸 즐긴다."

msgid "devidin_description"
msgstr "다시 살아난 디키노돈트가, 다들 늘 착각하는 그 공룡이 되기로 마음먹은 것이다."

msgid "devidra_description"
msgstr "자세히 보면 아주 가는 털 때문에 공룡인 척하는 악마 같은 속임수가 들통난다."

msgid "deviraptor_description"
msgstr "머리의 깃털 한 쌍은 가짜로, 악마 같은 진짜 정체를 암시한다."

msgid "dinoflop_description"
msgstr "다이노플롭은 공격하는 상대에게서 재빨리 등을 돌려, 공격이 방패 같은 가시 등에 맞게 하는 걸 즐긴다."

msgid "djinnbo_description"
msgstr "불에 타 죽은 인간이라는 오해를 받는다. 사실 불에 타 죽은 건 그 친척들이다."

msgid "doctsky_description"
msgstr "이 작은 하이에나는 그저 남을 돌보고 싶을 뿐이지만, 자기를 악당으로 그린 영화가 나온 뒤로 평판이 나빠졌다."

msgid "dollfin_description"
msgstr "저마다 배 한 척을 따라 이곳저곳을 다니며 세상을 탐험한다."

msgid "dracune_description"
msgstr "낮에는 움직이지 못하지만, 밤에는 꿈틀거리며 물 수 있다."

msgid "dragarbor_description"
msgstr "삶이 끝나 간다고 느끼면 무덤으로 가서 스스로를 심는다. 꼬리의 꽃은 영원히 자란다."

msgid "drashimi_description"
msgstr "땅에 누워 맛있는 냄새로 몬스터를 유혹한다. 하지만 다가오면 먼저 물어 버린다."

msgid "drokoro_description"
msgstr "한때 가족이 있었다. 하지만 부모를 먹고, 자식을 먹고, 짝을 먹고, 결국 자기 종족을 모두 먹어 버렸다."

msgid "duggot_description"
msgstr "텀블비가 과일즙을 마시려 할 때 더곳이 달라붙어 뇌를 장악할 수 있다."

msgid "dune_pincher_description"
msgstr "이 은둔자는 가장 가까이 있는 것으로 몸을 감싼다. 사막에서는 그게 오래전 죽은 파라오의 수의다."

msgid "eaglace_description"
msgstr "날아오르면 구름이 생기고, 날개를 맞부딪치면 우박이 내린다."

msgid "elofly_description"
msgstr "엘로플라이는 혼자 있을 때는 참을성 있고 현명하지만, 큰 무리를 지으면 난폭하고 충동적으로 변한다."

msgid "elostorm_description"
msgstr "왕이자 여왕인 엘로스톰은 무리를 다스리며 야망이 크다."

msgid "elowind_description"
msgstr "엘로플라이 일족의 부관인 엘로윈드는 무리를 이끌고 흩어지지 않게 한다."

msgid "embazook_description"
msgstr "전쟁용으로 훈련받았으며, 다른 삶은 알지 못한다."

msgid "embra_description"
msgstr "럽션이 될 만큼 크게 자라려고 먹을 수 있는 건 뭐든 먹는다."

msgid "enduros_description"
msgstr "엔듀로스는 주먹을 사리지 않는 공격적인 싸움꾼이다. 링 밖에서는 꽤 사교적이다."

msgid "equill_description"
msgstr "원한이 몸을 변하게 한다. 추한 모습을 어둠 속에 숨긴다."

msgid "eruptibus_description"
msgstr "대장장이들은 이 턱시몬의 분화구에서 금속을 달구며 함께 일한다."

msgid "erythroskyte_description"
msgstr "다정한 성격이지만, 거대한 주사기 꼬리 때문에 많은 이가 겁을 먹고 달아난다."

msgid "eskipup_description"
msgstr "새끼 때부터 1톤짜리 짐을 끌 수 있다."

msgid "exapode_description"
msgstr "다리를 흔들어 관심을 끌려 하지만, 사람들은 대개 도망친다."

msgid "exclawvate_description"
msgstr "공사 현장에서 자주 보이며, 거대한 손과 꼬리로 흙과 잔해를 퍼 올린다. 몸 아래에 무한궤도가 달려 있어 잔해 더미를 오를 때 균형과 접지력이 좋다."

msgid "eyenemy_description"
msgstr "아름다운 풍경과 장관을 먹고 산다."

msgid "eyesore_description"
msgstr "지금까지 본 것을 전부 기억하지만, 본 순서는 기억하지 못한다."

msgid "fancair_description"
msgstr "필요 없는데 선풍기를 틀어 두면, 살아나서 창밖으로 날아가 정말 더위를 식혀야 할 사람을 찾아간다."

msgid "ferricran_description"
msgstr "한때 페리크란은 온몸이 금강석 비늘로 덮여 있었고, 미스릴 날개를 지녔다."

msgid "firomenis_description"
msgstr "멀리쿤으로 오랜 세월을 보내 크고 튼튼하다. 턱은 나무와 뼈를 부수고, 사람을 태우고 날 만큼 힘차게 난다."

msgid "flacono_description"
msgstr "적을 전혀 두려워하지 않아서, 상대가 아무리 커도 망설임 없이 공격한다."

msgid "flambear_description"
msgstr "지나간 자리에 남은 익은 산딸기 덤불과 구운 송어를 따라가면 찾을 수 있다."

msgid "flisces_description"
msgstr "물 위를 스치듯 다니며 들키지 않다가, 힘찬 도약과 함께 날카로운 지느러미를 휘두른다."

msgid "fluoresfin_description"
msgstr "위협을 받으면 다른 플루오레스핀과 모여 눈부신 빛을 크게 내어 포식자를 혼란에 빠뜨린다."

msgid "fluttaflap_description"
msgstr "불순물을 먹고 살아서, 빨아들인 피를 깨끗하게 되돌려 준다."

msgid "foofle_description"
msgstr "한 마리가 위험에 처하면, 모든 푸플이 어디에 있든 그 울음소리를 듣는다."

msgid "flounce_description"
msgstr "플라운스는 고집 세고 혼자 다니는 성격으로, 그럴 만한 동기가 없으면 규칙을 모조리 무시한다."

msgid "flummack_description"
msgstr "플러맥은 더는 먹히길 원하지 않고, 먹길 원한다. 다른 플럼비와 플러맥도 맛있게 먹어 치운다."

msgid "flummby_description"
msgstr "플럼비는 먹히고 싶어 하는 음식이 더 윤리적일 거라 생각한 과학자가 발명했다. 자기를 먹을 수 있는 사람의 입속으로 뛰어든다."

msgid "fordin_description"
msgstr "위협을 받으면 공처럼 몸을 말고 통통 튀어 달아난다."

msgid "forturtle_description"
msgstr "등딱지를 달궈 생기는 금으로 미래를 읽는다."

msgid "foxfire_description"
msgstr "폭스파이어 새끼는 밤새 다 타 버린 불 자리에서 발견된다. 어디서 오는지는 아무도 모른다."

msgid "fribbit_description"
msgstr "한때 얼어붙은 가로등을 핥은 소년이었다고 한다."

msgid "frondly_description"
msgstr "감을 수 있는 꼬리로 무엇이든 한다. 악수도 하고 과일도 딴다."


# 06B_MON ##
msgid "frostuce_description"
msgstr "눈보라 속에서 초록색이 왈츠를 추며 돌아다닐 줄은 아무도 모른다."

msgid "fruitera_description"
msgstr "프루테라는 과일 욕심이 많아 들 수 있는 만큼 들고 다닌다. 깜짝 놀라면 과일을 전부 떨어뜨리고, 다시 다 주워 담은 뒤에야 도망친다."

msgid "furnursus_description"
msgstr "퍼너서스는 다정하지만, 자기 몸이 남이 만지기엔 너무 뜨겁다는 걸 자주 잊는다."

msgid "fuzzina_description"
msgstr "퍼즐릿을 버렸던 아이가 다시 그것을 필요로 하면, 퍼즐릿은 작고 약한 이를 지키고 보살피는 용감한 퍼지나가 된다."

msgid "fuzzlet_description"
msgstr "아이가 더는 장난감을 갖고 놀지 않게 되면, 장난감이 가끔 살아나기도 한다."

msgid "galasces_description"
msgstr "갈라시스는 몸 모양을 일그러뜨려 자기만 한 먹잇감도 통째로 삼킬 수 있다."

msgid "galnec_description"
msgstr "갈넥은 사막의 뜨거운 모래 속 깊이 몸을 묻고 돌 같은 꼬리만 내놓는다. 무리를 지으면 돌 정원처럼 보인다."

msgid "gastronium_description"
msgstr "가스트로니엄은 거의 뭐든 먹을 수 있지만, 무겁고 방사성 있는 물질을 좋아한다."

msgid "gectile_description"
msgstr "너무 빠르고 가벼워서 나뭇잎 위를 걸을 수 있다."

msgid "ghosteeth_description"
msgstr "만나는 모든 이가 어떻게 죽을지 알기 때문에 웃고 있다."

msgid "dynastor_description"
msgstr "다이나스터는 두꺼운 갑옷 같은 외골격과 등을 따라 난 독특한 날개를 지닌 거대한 곤충형 턱시몬이다. 큰 턱은 강철도 부순다."

msgid "gliffary_description"
msgstr "좀처럼 보기 힘든 장난꾸러기 요정 생물로, 버섯 고리 근처에 모여 쇠를 열심히 녹인다."

msgid "glombroc_description"
msgstr "기억을 바위 껍질에 저장한다. 껍질 일부가 떨어지면 건망증이 생긴다."

msgid "glomon_description"
msgstr "버려진 의료용 장갑 속 세균 군체가 새 생명이 된 것. 몸 뒤쪽으로도 볼 수 있다."

msgid "golnagi_description"
msgstr "골나기의 비늘은 빛을 내서, 즐겨 사냥하는 새벽과 해 질 녘에는 물속에서 거의 보이지 않는다."

msgid "gourda_description"
msgstr "가장 큰 고르다 키우기 대회에서는 1톤에 이르는 것도 나왔지만, 보통 고르다는 훨씬 작다."

msgid "graffiki_description"
msgstr "그래피키는 정글에서처럼 도시에서도 편하게 지내며, 화려한 그림으로 자기 영역을 표시한다."

msgid "grimachin_description"
msgstr "장난감 회사가 애완용으로 만들었지만, 너무 위험했다."

msgid "grinflare_description"
msgstr "하나하나가 걸어 다니는 화산의 심장이라고 한다."

msgid "grintot_description"
msgstr "그린트록이나 그린플레어가 침식된 모습이다."

msgid "grintrock_description"
msgstr "뇌우 속에 앉아 번개를 맞기를 기다리며 영양을 얻는다."

msgid "grumpi_description"
msgstr "그럼피에게 한번 붙잡히면 끈적끈적한 몸에서 절대 빠져나올 수 없다."

msgid "gryfix_description"
msgstr "뼈 갑옷이 그리픽스를 지켜 주어, 아주 강력한 공격이 아니면 통하지 않는다."

msgid "gupphire_description"
msgstr "거파이어의 비늘은 반짝반짝 빛나서 보는 이를 감탄하게 한다. 거파이어를 본 어부는 1년 내내 운이 좋을 거라 믿는다."

msgid "gupphish_description"
msgstr "거피시는 무리 지어 헤엄치는 걸 좋아해서, 팀워크를 중시하는 트레이너에게 인기가 많다."

msgid "hampotamos_description"
msgstr "리노시리드를 조금씩 뜯어 먹으며 죽은 피부와 이끼, 잡초를 없애 준다."

msgid "happito_description"
msgstr "사람들은 왜 늘 행복할 수 없을까? 해피토는 필요한 게 아니더라도 사람들이 원하는 것을 딱 그대로 준다."

msgid "hatchling_description"
msgstr "알이 부화해서 다음 삶을 시작하기 싫어하면 해칠링이 된다."

msgid "hectapod_description"
msgstr "머리 돔을 부풀리면 바다 위로 떠오르고, 안개와 구름 속을 떠다니기도 한다."

msgid "helipi_description"
msgstr "날개 하나로 회전하면 두 개일 때보다 더 멀리 날지만, 방향을 맞추기가 어려워진다."

msgid "heronquak_description"
msgstr "밀렵꾼들은 가슴의 수정을 다이아몬드로 착각한다. 헤론퀘이크의 몸에서 떼어 내면 녹아 버린다."

msgid "hissiorite_description"
msgstr "목 밑동에서 초고온 가스를 뿜어 몸을 감싸고, 열기구처럼 땅에서 몇 센티미터 떠오른다. 그래서 물 위에서도 빠르게 이동할 수 있다."

msgid "hoarse_description"
msgstr "가축처럼 보이지만, 주인에게 학대받았다."

msgid "hoarseshoo_description"
msgstr "이퀼의 그림자가 몸을 먹어 치우고 남은 것이다."

msgid "hoodoll_description"
msgstr "적을 저주하려고 가끔 자기 몸에 핀을 꽂지만, 꽂고 나서도 아무도 차이를 모른다."

msgid "hotline_description"
msgstr "호기심 많은 이 생물은 아주 멀리 뛰어오르며, 먹잇감이 아무리 멀리 도망쳐도 피할 수 없는 이상한 쇳소리를 낸다."

msgid "houndice_description"
msgstr "하운다이스는 썰매 타기를 좋아하지만, 눈 속에 묻힌 등산객을 냄새로 찾아내기도 한다."

msgid "howl_description"
msgstr "하울의 어리숙한 겉모습 뒤에는 깊은 지혜가 숨어 있다. 전할 수만 있다면 좋겠지만, 말이 부엉부엉, 우우 소리로만 나온다."

msgid "hydrone_description"
msgstr "물로 전력을 만드는 실험 기술을 이용한다."

msgid "ignibus_description"
msgstr "위협을 받으면 등딱지 속으로 숨어 증기를 뿜어 몸을 급격히 식힌다. 바위로 착각하기 쉽다."

msgid "imbrickcile_description"
msgstr "임브리크실은 벽돌 한 장 속에 숨어 지내며, 힘을 기르려고 벽돌을 들어 올릴 때만 나온다."

msgid "incandesfin_description"
msgstr "몸 전체가 엄청나게 커졌다. 하지만 빛은 예전과 똑같다."

msgid "jelillow_description"
msgstr "젤릴로에 머리를 기대면 젤리 같은 피부 때문에 깊은 잠에 빠진다. 잠을 잘 못 자는 사람을 돕는 데 쓰인다."

msgid "jeluna_description"
msgstr "달이 젤루나에게 기묘한 영향을 미쳐, 이 하늘 해파리는 한 달 동안 모습이 바뀐다."

msgid "jemuar_description"
msgstr "등의 보석은 태어난 곳에서 나는 종류다. 다이아몬드 광맥 위에 대규모 록키튼 번식장이 있다."

msgid "joulraton_description"
msgstr "정전기를 띤 뻣뻣한 털에 씨앗, 꽃, 깃털이 달라붙는데, 이를 먹이나 둥지 재료로 쓴다."

msgid "k9_description"
msgstr "1톤 무게도 끌 수 있는 든든한 동료다."

msgid "katacoon_description"
msgstr "번데기 시절 내내 명상 자세로 있다가, 적을 찌를 때만 움직인다."

msgid "katapill_description"
msgstr "태어날 때부터 싸운다. 알껍데기를 주먹으로 깨고 나오지 못하면 갇히고 만다."

msgid "kernel_description"
msgstr "커널은 몬스터 시스템(보호소)과 아이템 시스템(보관함)의 핵심 구성 요소로, 컴퓨터의 물리적 하드웨어와 그 위에서 돌아가는 프로세스를 잇는 주요 인터페이스다. 만든 이들은 JAS-KERI-BIT라고 부른다."

msgid "knightsand_description"
msgstr "나이트샌드는 포샌드가 사는 모래성 주위를 순찰하지만, 모래성 짓는 솜씨는 형편없다."

msgid "knindling_description"
msgstr "돌에서 튄 불꽃은 무엇이든 닌들링이 기꺼이 불로 키운다."

msgid "komodraw_description"
msgstr "발톱으로 나무를 깎아 총을 만들고, 그것으로 강력한 원거리 공격을 한다."

msgid "komoduel_description"
msgstr "다가오는 코모듀얼의 그림자만 보고도 마을을 떠난 악당이 한둘이 아니다."

msgid "konuit_description"
msgstr "어떤 곳에서는 코누잇을 '떨어지는 곰'이라 부르며, 방심한 사람 머리 위로 떨어진다고 믿는다."

msgid "kroki_description"
msgstr "크로키는 대부분의 시간을 얕은 물에서 보내며, 강한 턱으로 먹잇감을 덥석 문다."

msgid "krokivip_description"
msgstr "이 독 악어는 물속에서 매복하는 걸 좋아한다. 진화가 가까워질수록 더 넓은 물을 찾는다."

msgid "lambert_description"
msgstr "부모가 열매 껍데기 속에 넣어 세상으로 내보낸다."

msgid "lapinou_description"
msgstr "스쿼빗이 유행하는 애완동물이 되면서 집안 생활에 적응해 사나운 본성을 잃었다."

msgid "legko_description"
msgstr "오랫동안 다리가 없다고 여겨졌지만, 잎이 사실 퇴화한 팔다리다."

msgid "legoplaste_description"
msgstr "몸 모양이 아주 유동적이며, 촉수를 아무렇게나 뻗어 근처 먹잇감의 냄새를 맡거나 만지며 사냥한다."

msgid "lendos_description"
msgstr "언아이 두 마리가 엉키면 하나로 합쳐진 렌도스가 된다."

msgid "lesmagu_description"
msgstr "껍데기가 생길 때까지 해저를 미끄러지듯 다니며 숨을 단단한 틈새를 찾는다."

msgid "lettice_description"
msgstr "추운 날씨는 레티스의 힘과 활력을 응축시킨다."

msgid "leviadile_description"
msgstr "거대한 몸집과 강력한 독 턱을 지닌 레비아다일은 심해의 지배적인 포식자다."

msgid "lightmare_description"
msgstr "바다 깊은 곳에 숨어서, 방심한 먹잇감을 빛으로 꾀어 크게 벌린 입속으로 끌어들인다."

msgid "loliferno_description"
msgstr "롤리페르노의 불은 끌 수 없다고 한다. 그런 힘을 지녔지만 장난기도 있어서, 자기가 만든 불길 속에서 춤추곤 한다."

msgid "lucifice_description"
msgstr "나무 사이로 울부짖는 바람일까, 아니면 루시피스가 밤의 어둠 정령들을 사냥에 부르는 소리일까?"

msgid "lunight_description"
msgstr "루나이트는 밤의 수호자로, 달과 달의 위상을 조종할 수 있다."

msgid "manosting_description"
msgstr "도시 위를 떠다니며 상어에 대해 사색한다."

msgid "marvantis_description"
msgstr "진화하고 나면 원래의 흉내 내기 흔적은 붉은 장식만 남는다."

msgid "marvillar_description"
msgstr "마빌라는 냄새로 개미 애벌레를 흉내 낸다. 스칼란트와 머미슨이 자기를 먹이게 만들고, 의심하는 개미는 잡아먹는다."

msgid "masknake_description"
msgstr "겁을 먹거나 공격적일 때 꼬리로 아름다운 무늬를 번쩍인다."

msgid "mauai_description"
msgstr "마우아이는 자기 무기 속에 갇힌 잃어버린 전사들의 영혼에게 몸을 내맡긴다."

msgid "medipup_description"
msgstr "메디펍은 병을 냄새로 찾아내면 통통 뛰어가 아픈 생물에게 코를 비빈다. 촉촉한 코는 효과가 좋지만, 지나치게 열성적인 무리에게 깔린 환자도 있다."

msgid "medushock_description"
msgstr "해안에서 떨어져 지내는 편이며, 사람에게 공격적이라고 알려져 있다. 침으로 먹잇감을 마비시킨다. 안전하게 수영하세요."

msgid "megafruitera_description"
msgstr "어린 시절보다 자제력이 조금 나아져서, 과일을 더 둘 곳이 필요하면 먼저 둥지를 넓힌다."

msgid "memnomnom_description"
msgstr "하나하나의 가면이 저마다 다른 죽은 왕의 얼굴이라고 한다."

msgid "merlicun_description"
msgstr "멀리쿤은 공격과 방어 모두에 능하도록 진화한 튼튼한 곤충이다. 고대 숲의 우거진 나무 꼭대기에 모여 열매와 잎을 먹는다."

msgid "metesaur_description"
msgstr "땅속으로 뛰어들어 자국을 남기는 걸 좋아한다. 가끔 착지를 잘못해 나무에 떨어지면 크고 위험한 산불을 일으킨다."

msgid "metoxic_description"
msgstr "메톡식은 가끔 포샌드 모래성의 깃발 역할을 하며 사방에 독 연기를 뿜는다."

msgid "miaownolith_description"
msgstr "사람 말을 할 수 있지만, 알쏭달쏭한 수수께끼만 말한다."

msgid "mingdyn_description"
msgstr "12년마다 밍딘의 알이 단 하나 낳아진다. 그 알이 발견되면 온 땅에 새로운 시작과 격변이 찾아온다."

msgid "moloch_description"
msgstr "친구와 적에 따라 피부를 단단하게도, 부드럽게도 할 수 있다."

msgid "mrmoswitch_description"
msgstr "이 건방진 로봇은 섬세한 손재주 때문에 쓰이지만, 장난을 무척 좋아한다."

msgid "myrmison_description"
msgstr "머미슨 여왕은 습한 날 새 군락을 세우려고 밖으로 나온다. 이때가 가장 위험한 시기다."

msgid "mystikapi_description"
msgstr "미스티카피의 침은 초능력을 강화한다. 눈과 귀를 핥아 감각을 날카롭게 한다."

msgid "narcileaf_description"
msgstr "샤이벌브가 정원을 옛 모습으로 되살리면, 변이해서 그 공을 자랑스럽게 차지한다."

msgid "nebufin_description"
msgstr "네뷰핀의 천사 같은 모습에 속으면 안 된다. 이 몬스터는 포식자다."

msgid "ned_description"
msgstr "네드는 코누잇과 라이벌이지만, 코누잇은 말다툼 대부분을 자면서 흘려보낸다."

msgid "neutrito_description"
msgstr "뉴트리토는 아무것도 느끼지 않는다. 완벽한 기계일까?"

msgid "nimbulex_description"
msgstr "님뷸렉스는 섬세한 내부 코어를 지키려고 불꽃과 먹구름으로 몸을 감싼다."

msgid "ninjasmine_description"
msgstr "닌자스민은 독검 두 자루로 상대를 재빨리 독에 빠뜨린다."

msgid "noctalo_description"
msgstr "성, 묘지, 하수도처럼 인간이 버린 곳에만 산다."

msgid "noctula_description"
msgstr "녹툴라는 과일을 먹고 피피스는 벌레를 먹어서, 가까이 살아도 서로 다투지 않는다."

msgid "nostray_description"
msgstr "아무리 멀리 있어도 바닷속의 모든 냄새를 맡을 수 있다."

msgid "novaquarius_description"
msgstr "노바쿼리어스에게 쏘이면 방심한 사람은 병원에 실려 가지만, 버비토이즈는 면역이 생겨 노바쿼리어스를 뜯어 먹는다."

msgid "nudiflot_female_description"
msgstr "먹이로 삼는 바다 생물의 독을 먹고 몸에 저장한다."

msgid "nudiflot_male_description"
msgstr "공격을 받으면 깃털 같은 더듬이가 떨어져 나가 포식자를 헷갈리게 한다."

msgid "nudikill_description"
msgstr "머리가 주교의 모자를 닮아서 '어둠의 비숍'이라 불린다."

msgid "nudimind_description"
msgstr "다른 하늘 아래의 바다를 꿈꾼다."

msgid "nuenflu_description"
msgstr "겨울철에 집 안으로 파고들어 병을 퍼뜨린다."

msgid "nut_description"
msgstr "바다를 건너는 거대한 배에서는 수천 마리의 넛과 볼트가 동력을 만들고 강철판을 붙들고 있다."

msgid "octabode_description"
msgstr "옥타보드는 고대의 그릇과 유물을 집으로 삼고, 그 유물을 쓰던 이들의 삶을 꿈꾼다."

msgid "ouroboutlet_description"
msgstr "회로가 에너지를 모아, 슬픔 번개라는 새로운 종류의 전기를 만들어 낸다."

msgid "pairagrim_description"
msgstr "페어러그림의 한쪽 머리는 늘 먹잇감을 찾고, 다른 쪽 머리는 빠르게 나는 데 집중한다."

msgid "pairagrin_description"
msgstr "페어러그림의 어린 모습으로, 대체로 행복한 생물이다. 두 머리가 협력하는 법을 배울 때까지는 잘 날지 못한다."

msgid "pantherafira_description"
msgstr "무리의 구성원은 모두 함께 쓰는 모닥불에서 갈기에 불을 붙인다. 그 불이 타는 한 그들은 힘을 나눈다."

msgid "parappi_description"
msgstr "파라피는 베이면 시럽이 흘러나와 적을 덮고 굳어 호박 속에 가둬 버린다."

msgid "pawsand_description"
msgstr "포샌드는 비쇼샌드와 룩샌드가 만든 모래성과 모래 신전에 사는데, 그중 일부는 사실 룩샌드 자신이다."

msgid "pearamanca_description"
msgstr "페어러만카는 그냥 과일을 사려는 순진한 사람들에게 보험을 판다. 그래서 가장 무서운 몬스터다."

msgid "pharavion_description"
msgstr "트레이너가 엄청나게 노력하면 서투른 파판 새끼를 어른 모습으로 진화시킬 수 있다. 어른은 거대한 몸집에도 우아하게 떠다닌다."

msgid "pharfan_description"
msgstr "물웅덩이에서 친구인 리노시리드와 햄포타모스에게 물을 넉넉히 뿌려 준다."

msgid "picc_description"
msgstr "잠수부와 함께 다니며 꼭 필요한 산소를 공급한다."

msgid "pickoon_description"
msgstr "물건을 주워서 몰래 목도리 속에 쑤셔 넣는 걸 좋아한다."

msgid "pigabyte_description"
msgstr "과학자들은 최고의 컴퓨터에는 생체 이식물이 있다는 걸 알아냈다."

msgid "pilthropus_description"
msgstr "린커스 같은 턱시몬과 함께 발견되며, 스스로 도구를 만들 수 있었던 가장 오래된 턱시몬 중 하나다."

msgid "pipis_description"
msgstr "울음소리가 불길한 징조로 여겨지지만, 온순한 생물이다."

msgid "poinchin_description"
msgstr "포인친은 산호에 둥지를 틀며, 빵과 우유로 꾀어낼 수 있다."

msgid "polyrock_description"
msgstr "사람 아이로 변장해 도장에 숨어들어 무술 고수에게 배운다."

msgid "possessun_description"
msgstr "죽은 케어프리에 깃든 유령이다."

msgid "potturmeist_description"
msgstr "포터마이스트는 빈 그릇에 숨어든 죽은 이의 영혼이다. 고대 신전에서는 중요한 의식을 방해하지 못하게 수련 사제가 이 몬스터의 주의를 돌려야 한다."

msgid "potturney_description"
msgstr "포터마이스트가 다 자랄 무렵이면 몸을 지키던 항아리 모양이 너무 변해서 사람이 만든 도자기와는 전혀 닮지 않게 된다. 항아리의 무늬가 먼 미래의 글이라고 주장하는 사람도 있다."

msgid "primordia_description"
msgstr "모든 턱시몬의 조상이라는 소문이 있다."

msgid "propellercat_description"
msgstr "새로운 종일까, 아니면 그냥 어느 발명가의 애완동물일까?"

msgid "prophetoise_description"
msgstr "그 천상의 불은 적이 좀처럼 예상하지 못한다."

msgid "puparmor_description"
msgstr "고치가 너무 단단해서, 퓨파머가 머리 위로 떨어지면 사람이 기절한다. 한때는 대포와 투석기에 넣어 쏘기도 했다."

msgid "pyraminx_description"
msgstr "이 땅 어딘가에 자기 무덤이 숨겨져 있다. 그것을 찾으면 잠들 수 있다."

msgid "pythock_description"
msgstr "그림자 인형을 부려 아주 정확하고 빠르게 상대와 싸운다. 자신감이 넘쳐서, 가끔 인형극에서 그림자 인형으로 어린아이들을 즐겁게 해 주기도 한다."

msgid "pythonova_description"
msgstr "성미가 급해서 화가 나면 등의 불길이 더 뜨거워지고 연기 꼬리가 더 굵고 길어진다. 연기 꼬리로 상대를 휘감아 숨 막히게 한다."

msgid "pythwire_description"
msgstr "야생 파이스와이어를 관찰한 것이 최초의 전기 콘센트 발명에 영감을 주었다."

msgid "qetzlrokilus_description"
msgstr "다른 공룡 턱시몬 무리 속으로 뛰어들어 불태우곤 했다. 숲에 불을 지르고 그 재를 물에 떨어뜨려 물을 더럽히는 것도 좋아한다."

msgid "rabbitosaur_description"
msgstr "굴이 넓고 길게 뻗어 있어서, 굴과 굴 사이에 엄청난 전쟁이 벌어지는 무대가 된다."

msgid "raccscal_description"
msgstr "등에 여닫을 수 있는 주머니 같은 꼬리가 있으며, 떼어서 적에게 던지기도 한다."

msgid "raptoucan_description"
msgstr "무시무시하고 공격적이지만, 과일만 먹는다."

msgid "regalance_description"
msgstr "필요할 때마다 미늘창을 불러낼 수 있다."

msgid "rhincus_description"
msgstr "파충류의 특징과 새의 특징을 함께 지녔다."

msgid "rhinocarpe_description"
msgstr "라이노카프는 영역 의식이 강해서, 산호 요새에 너무 가까이 헤엄쳐 오는 자에게 머리부터 돌진한다."

msgid "rinocereed_description"
msgstr "너무 빨리 자라서 늘 엄청나게 배고프다. 식물만 먹는 것도 아니다."

msgid "rockat_description"
msgstr "몸무게가 상당한데도 발소리가 전혀 나지 않는다."


# 06C_MON ##
msgid "rockitten_description"
msgstr "작은 바위 귀를 비비며 응석을 부린다."

msgid "rooksand_description"
msgstr "룩샌드는 자격이 있다고 인정한 자만 모래성 안에 살게 하고, 나머지는 모두 짓뭉갠다."

msgid "rosarin_description"
msgstr "로사린의 사랑은 엄청나다. 그저 조금의 애정을 바랄 뿐이다."

msgid "ruffalo_description"
msgstr "러팔로는 엄청난 힘으로 빠르게 돌진해 나무와 작은 건물도 쓰러뜨릴 수 있다."

msgid "runesquito_description"
msgstr "핏빛 무늬가 룬스키토다. 나머지는 그냥 함께 타고 다니는 바위 껍데기다."

msgid "ruption_description"
msgstr "엠브라의 불꽃이 충분히 뜨거워지면 온몸을 감싸고, 그 과정에서 사실상 몸을 대신하게 된다."

msgid "sadito_description"
msgstr "누군가 너무 슬퍼하면, 새디토가 그 짐을 대신 짊어진다."

msgid "sampsack_description"
msgstr "한 과학자가 자기 인격을 분리하려다 몸을 쪼개 버렸다."

msgid "sampsage_description"
msgstr "한 과학자가 낮에는 영리하고 밤에는 난폭해지는 약을 먹었다."

msgid "sapragon_description"
msgstr "옛날에는 원소마다 강대한 드래곤이 있었지만, 이제는 줄어들어 보기 드물다."

msgid "sapsnap_description"
msgstr "엄청나게 화를 내서 정이 떨어지지만, 금방 풀린다."

msgid "saurchin_description"
msgstr "밤이 되면 소친은 산호초에서 나와 땅 위에서 더 큰 먹잇감을 사냥한다."

msgid "scarlant_description"
msgstr "최악의 적은 동족인 척하는 마빌라다."

msgid "sclairus_description"
msgstr "게으름이든 재앙이든 거두지 않은 농작물이 남으면, 그 허수아비가 살아 있는 어둠의 생물이 된다."

msgid "seirein_description"
msgstr "늪에서 외로워져 밝게 타올라 여행자를 끌어들이지만, 너무 수줍어서 다가오면 휙 날아가 버린다."

msgid "selket_description"
msgstr "모래 아래에서 기다리며, 발소리의 진동으로 먹잇감을 알아챈다."

msgid "selmatek_description"
msgstr "사막의 고대 왕들이 기르던 셀마텍은 집 지키는 개이자 사냥 동료였고, 지금은 도굴꾼을 막는 수호자다."

msgid "seraphice_description"
msgstr "세라파이스는 위대한 용기와 기쁨의 순간을 얼음 속에 얼려, 인류가 가장 필요로 할 날을 위해 산 아래 깊은 금고에 보관할 수 있다."

msgid "shammer_description"
msgstr "고대에는 잿빛 하늘 아래에서 린커스를 사냥했다."

msgid "sharpfin_description"
msgstr "물속에서는 보이지 않다가, 물가의 동물을 깊은 곳으로 끌고 가려고 뛰어오를 때만 모습을 드러낸다."

msgid "shelagu_description"
msgstr "입으로 뱉은 끈적한 액체로 가시 껍데기에 독을 발라 공격자를 쫓는다."

msgid "sheye_description"
msgstr "샤이는 무거운 생각에 짓눌려 있다. 반항기 있는 트레이너들이 그 불길한 외모와 엄숙한 태도를 좋아한다."

msgid "shimmerain_description"
msgstr "물 위에 무지개가 뜨면 시머레인이 알을 낳고 있는 거라고 한다."

msgid "shnark_description"
msgstr "슈나크는 방심한 먹잇감에게 다가가려고 지난번 먹잇감의 살을 뒤집어쓰고 변장한다."

msgid "shrab_description"
msgstr "샤이가 늘 진지한 생각에 잠겨 있던 마음을 해방하면, 몸도 자유로운 슈랩이 되어 세상을 떠돈다."

msgid "shybulb_description"
msgstr "정원이 방치되면 샤이벌브가 찾아와 축 처진 식물들을 조용히 돌본다."

msgid "shull_description"
msgstr "슐은 먹거나 움직일 필요가 없지만, 좋아하는 사람이 주는 간식과 영양제는 즐긴다. 배틀에 자주 나간다면 더더욱."

msgid "skwib_description"
msgstr "스퀴브는 바닷속을 느긋하게 떠다니며 집으로 삼을 껍데기를 살핀다. 목숨이 위태로워져야 비로소 하나를 고른다."

msgid "slichen_description"
msgstr "불꽃을 받아 살아난 젤이 돌과 바위로 자기 몸을 만들기 시작한 것이다."

msgid "sludgehog_description"
msgstr "쓰레기 속에서 살고, 쓰레기를 먹기도 한다. 가시가 날카로워 보이지만 마음대로 부드럽게 할 수 있다."

msgid "snaki_description"
msgstr "스나키는 도마뱀과 악어의 움직임을 관찰해 다리를 기르는 법을 배운 뱀이다."

msgid "snarlon_description"
msgstr "날지 않지만, 발이 땅에 닿는 일도 없다. 역설의 왕."

msgid "snock_description"
msgstr "뱀처럼 생긴 이 생물은 양말 덮개 속에 안전하게 숨어 있다. 놀라면 버둥거리다가 눈에 띄지 않으려고 땅에 꼼짝 않고 누워 있다."

msgid "snokari_description"
msgstr "스노카리의 두 머리는 각자 큰 지혜를 지녔지만, 의견이 맞는 법이 없다."

msgid "snowrilla_description"
msgstr "인적 없는 비탈에서 스키어와 술래잡기하는 걸 즐긴다."

msgid "sockeserp_description"
msgstr "평소엔 무시무시한 적이지만, 몸이 엉키면 쉽게 처리할 수 있다."

msgid "solight_description"
msgstr "어느 악당 조직이 솔라이트로 작은 태양을 만들어 새 행성을 창조하려는 음모를 꾸미고 있다."

msgid "spectera_description"
msgstr "잎사귀 날개를 지닌 이 박쥐는 잡식성이지만 과일을 더 좋아한다. 암수가 함께 새끼를 돌본다."

msgid "sphake_description"
msgstr "스페이크는 가끔 작은 지진을 일으켜 선반의 책과 컵을 떨어뜨린다. 그리고 떨어진 건 뭐든 먹는다."

msgid "spighter_description"
msgstr "몰래 다가가는 데 그렇게 능숙한데, 정작 자기한테 몰래 다가오는 건 안 통한다니 불공평하다."

msgid "spirain_description"
msgstr "세이렌의 내면의 불이 희미해지면, 물의 정령의 본성이 드러나 스피레인이 된다."

msgid "spoilurm_description"
msgstr "스포일럼은 사과로 변장해 나무에서 기다리다가 방심한 이를 잡아먹는다."

msgid "sprightly_description"
msgstr "수줍은 식물로, 물과 햇볕을 마시려고 땅 위로 고개를 쏙 내민다."

msgid "sprorm_description"
msgstr "스프롬은 카디날레의 먹이가 되며, 카디날레는 스프롬을 녹여 버릴 수 있다."

msgid "spycozeus_description"
msgstr "숲이 속삭이는 대화가 스파이코제우스라는 몸을 얻었다. 나무처럼 생각한다."

msgid "squabbit_description"
msgstr "자기를 증명하려고 아주 사소한 일에도 죽기 살기로 싸운다."

msgid "squink_description"
msgstr "먹물이 다 떨어졌을 때 내는 소리에서 이름을 따왔다."

msgid "statursus_description"
msgstr "스태터서스는 감정을 하나의 순수한 불꽃으로 모으는 법을 익혔다. 그 모습을 보기만 해도 다른 이들은 무아지경에 빠진다."

msgid "stegofor_description"
msgstr "변이할 때가 되면 스테고포는 큰 무리를 지어 옛길을 따라 이동하며, 길가의 식물을 모조리 먹어 치운다."

msgid "stomic_description"
msgstr "스토믹은 방사능을 띠지만, 글로몬 같은 방사선 내성 세균은 여전히 위협이 된다."

msgid "stonifly_description"
msgstr "스토니플라이의 단단한 바위 같은 외골격은 천연 갑옷이고, 반투명한 날개로 빠르게 난다."

msgid "strella_description"
msgstr "꼬리는 벌레를 꾀어 물게 해서 가두는 미끼다."

msgid "sumchon_description"
msgstr "자기 몸무게를 이용해 훨씬 큰 적도 넘어뜨린다. 별만큼 밀도가 높다."

msgid "tadcool_description"
msgstr "사람이 얇은 얼음 근처를 걸으면 개굴개굴 울어 경고한다."

msgid "tarpeur_description"
msgstr "쉬면서 자란다. 자라면서 쉬기도 한다. 드물게 자라지 않고 쉬거나, 쉬지 않고 자라기도 한다."

msgid "taupypus_description"
msgstr "토피퍼스가 태어나면 어미가 눈을 터뜨린다. 그래서 물속에 뛰어들어도 눈이 따갑지 않다."

msgid "teddisun_description"
msgstr "테디선은 태양을 숭배한다. 늘 태양 장난감을 들고 다닌다."

msgid "tetrchimp_description"
msgstr "접하는 정보는 무엇이든 흡수한다. 끊임없는 수다로 배운 것을 전부 순서대로 전한다."

msgid "thumpurn_description"
msgstr "주먹으로 적을 쿵쿵 때리고, 땅을 쿵쿵 쳐서 경고한다."

msgid "tigrock_description"
msgstr "진화가 설계되지 않아서 스스로를 발명해야 했다고 한다."

msgid "tikoal_description"
msgstr "숲에 사는 부족의 수호자로, 경계를 서고 분쟁을 해결한다."

msgid "tikorch_description"
msgstr "숲과 화산, 태양과 대지 사이를 잇는 중재자다."

msgid "tobishimi_description"
msgstr "토비시미는 알을 엄청나게 많이 낳아, 다음 보름달에 부화할 때까지 턱 밑에 품고 다닌다."

msgid "tornicane_description"
msgstr "토니케인은 토네이도와 허리케인의 힘을 모두 다룬다. 살아 있는 자연의 힘으로, 비를 바라는 이에게 구원이 될 수도 파멸이 될 수도 있다."

msgid "toucanary_description"
msgstr "투커너리의 깃털이 화려한 건 꽃에 둘러싸여 자랐기 때문이다."

msgid "toufigel_description"
msgstr "폭신한 곤충처럼 보이지만, 사실은 부드러운 눈으로 덮인 파충류다."

msgid "tourbidi_description"
msgstr "버섯이나 클로버가 동그랗게 자란 곳을 발견하면, 그곳은 투르비디가 춤추는 곳이다."

msgid "toxiris_description"
msgstr "톡시리스는 엄청나게 강력해서, 앞을 가로막는 모든 것을 맹렬하게 독에 빠뜨린다."

msgid "trapsnap_description"
msgstr "나이가 들어도 머리만은 자라지 않는다."

msgid "trojerror_description"
msgstr "트로제러는 정상적인 코드나 소프트웨어로 변장하는 턱시몬이다. 네트워크에 들어가면 정상 사용자가 할 수 있는 모든 일(입금, 출금, 삭제)을 할 수 있다."

msgid "tsushimi_description"
msgstr "갑옷이라 불리기도 하지만, 쓰시미의 살덩이 판은 피부보다 부드럽다. 무엇에 쓰는지는 아직 모른다."

msgid "tumblebee_description"
msgstr "완벽한 구 모양의 벌집을 짓고, 그 안에서 텀블비가 데굴데굴 구르며 웃음 섞인 윙윙 소리를 낸다."

msgid "tumbledillo_description"
msgstr "텀블딜로는 특정한 길과 신비한 인연이 있어, 그 길을 건드리려는 사람들로부터 지킨다. 포트홀 보수 작업반까지도!"

msgid "tumblequill_description"
msgstr "텀블퀼은 고속도로를 따라 굴러다니며, 길가에 버려진 쓰레기 중에서 둥지에 쓸 만한 걸 모은다."

msgid "tumbleworm_description"
msgstr "벌집 알보다 몸이 커지면 얼굴부터 땅으로 떨어진다."

msgid "turnipper_description"
msgstr "밭이 까마귀와 메뚜기와 쥐에게 버려지면, 가끔 터니퍼가 땅을 파고 나와 작물을 지킨다."

msgid "tux_description"
msgstr "극지방 기후를 가장 편하게 여기며, 약한 먹잇감은 덮쳐서 사냥하고, 강한 먹잇감은 얼음 위로 미끄러뜨려 단단한 바위에 부딪쳐 껍데기나 갑옷을 깨뜨린다."

msgid "tweesher_description"
msgstr "날씨가 추울수록 부리가 단단해진다. 영하에서는 다이아몬드보다 단단하다."

msgid "uf0_description"
msgstr "이 이상한 생물은 사람 귀로는 들을 수 없는 높은 소리에 끌리는 것 같다."

msgid "uglip_description"
msgstr "깊은 물속 집에서 너무 빨리 끌어올리면 어글립은 퉁퉁 붓고 괴로워한다."

msgid "uneye_description"
msgstr "언아이는 그림자 속, 그리고 시야의 가장자리에 숨어 있다."

msgid "uprout_description"
msgstr "다 자라면 귀가 벗겨지며 날개가 드러나고, 그 날개로 자기가 자란 곳 위의 나무로 날아오른다."

msgid "urcheedle_description"
msgstr "움직이지도 공격하지도 못해서, 가만히 앉아 상대가 수많은 바늘에 스스로 다치길 기도한다."

msgid "urcine_description"
msgstr "퍼너서스가 몸속에 불 없이 태어나면, 어사인이 되어 숲에 버려진다."

msgid "vamporm_description"
msgstr "피에 굶주려 있지만, 나무 수액으로 만족해야 한다."

msgid "velocitile_description"
msgstr "총알보다 빨리 달릴 수 있다. 단, 몸이 데워졌을 때만."

msgid "vigueur_description"
msgstr "비괴르는 누가 가장 무거운 바위를 드는지 겨룬다. 너무 무거운 바위를 들면 깔려 버리고, 타퍼의 씨앗이 흩어진다."

msgid "virware_description"
msgstr "바이어웨어는 보통 잠들어 있다가, 피해자가 손상된 앱을 내려받거나 감염된 링크를 누르면 깨어난다. 깨어나면 온갖 일을 해낼 수 있다."

msgid "vivicinder_description"
msgstr "오래 타는 불 속에 둥지를 튼다. 직접 피운 불일 때도 있고, 추모의 불이나 대장간, 유리 공방의 불일 때도 있다."

msgid "vividactil_description"
msgstr "고대에 비비닥틸의 해는 새로운 시작과 권위 회복의 시기였다."

msgid "vivipere_description"
msgstr "여름에 엄청난 수가 부화하지만, 그 뒤의 삶은 수수께끼다."

msgid "viviphyta_description"
msgstr "뱀의 왕이다. 적어도 자기는 그렇게 믿는다."

msgid "vivisource_description"
msgstr "이 턱시몬이 집으로 고른 샘물에서는 늘 묘한 양파 맛이 난다."

msgid "viviteel_description"
msgstr "쓰러진 전사의 갑옷을 가져다 껍데기로 다시 쓴다."

msgid "vivitrans_description"
msgstr "추위는 비비트랜스의 정신을 날카롭게 벼린다."

msgid "vivitron_description"
msgstr "초기 철학자들은 비비트론을 자연의 힘을 길들이고 다룰 수 있다는 증거로 삼았다."

msgid "volcoli_description"
msgstr "숲의 정령이다. 털이 계절에 따라 바뀐다."

msgid "volconey_description"
msgstr "볼코니가 거대한 발로 땅을 쿵 치면 섬펀과 볼코니가 점점 더 많이 굴로 모여든다. 충분히 많은 수가 한꺼번에 땅을 치면 화산이 분화한다고 한다."

msgid "vulpyre_description"
msgstr "어떻게 진화하고 사는지는 수수께끼지만, 가끔 화산 근처에서 목격된다."

msgid "waysprite_description"
msgstr "웨이스프라이트는 사람이 어려운 결정을 마주할 때 생겨난다고 한다."

msgid "weavifly_description"
msgstr "알을 배어 몸이 무거워지면 날지 못하게 된다."

msgid "weedlantis_description"
msgstr "고대 문명이 위들랜티스를 조언자로 삼았다고 하지만, 그 문명은 바닷속으로 사라졌다."

msgid "weedsea_description"
msgstr "1년에 한 번, 슈랩 같은 수생 턱시몬이 파도 아래에서 꽃가루를 옮겨 준다."

msgid "wendigger_description"
msgstr "제대로 묻히지 못한 시체가 웬디거로 자라날 수 있다고 한다."

msgid "windeye_description"
msgstr "윈드아이는 커다란 나무처럼 언덕 꼭대기에 뿌리를 내리고 햇볕과 바람을 흠뻑 받는다. 기운을 다 채우면 하늘 아래 다른 곳을 찾아 떠난다."

msgid "wolffsky_description"
msgstr "아주 다정한 턱시몬이다. 울프스키의 도움을 받아 사냥하는 일이 흔하다."

msgid "wolololl_description"
msgstr "월롤롤의 날카로운 가시 끝에는 치명적인 독이 있다."

msgid "woodoor_description"
msgstr "유령의 집이 불타 무너지면 가끔 현관문만 남는다. 그 문은 다음 집을 찾아 깡충깡충 떠난다."

msgid "wrougon_description"
msgstr "루곤은 태어날 때마다 부모보다 큰 녹 얼룩을 지니고 태어난다."

msgid "yiinaang_description"
msgstr "별이 처음으로 블랙홀에 떨어졌을 때 태어났다."

msgid "yamada_description"
msgstr "유령은 장난꾸러기로 유명하지만, 야마다는 법을 진지하게 여기며 힘보다 올바른 행동을 더 중요하게 생각한다."

msgid "ziggurat_description"
msgstr "어떤 미궁도 지구랫을 가둘 수 없다. 오랜 세월 지나온 모든 미로를 둥지에 새겨 장식한다."

msgid "zunna_description"
msgstr "명랑한 주나는 찾을 수 있는 음식을 전부 배 속으로 빨아들인다."

