msgid "maamiexist4"
msgstr "됐어, 놔둬. 이 사람들은 취향도 형편없고 쓸모와 단순함을 싫어하는 게 분명하니까...\n그랜트, 이제 연구소를 확인해. 난 존을 기다릴게."

msgid "itsmyaurababe"
