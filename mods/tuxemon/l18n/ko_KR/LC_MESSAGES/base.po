msgid "riposte_description"
msgstr "방어 자세를 취해, 어떤 공격이든 빠르고 강하게 받아칠 준비를 한다."

msgid "rock_description"
msgstr "무거운 바위가 상대 위로 떨어진다."

msgid "rocky_barrage_description"
msgstr "바위를 맹렬하게 퍼부어, 돌 사태로 상대를 짓눌러 버리려 한다."

msgid "roll_description"
msgstr "몸을 공처럼 말아 상대를 깔아뭉개거나 들이받는다."

msgid "rot_description"
msgstr "상대에게 병이 찾아온다."

msgid "ruby_description"
msgstr "루비 같은 에너지를 응축한 광선을 쏘아 피해를 준다."

msgid "rust_bomb_description"
