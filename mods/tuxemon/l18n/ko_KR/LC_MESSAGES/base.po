msgid "oven_description"
msgstr "불타는 오븐이나 장작더미에 몸을 던졌다가 다시 나와 공격한다."

msgid "overfeed_description"
msgstr "상대에게 에너지를 과하게 주입해 느리게 만든다."

msgid "overgrowth_description"
msgstr "덩굴이 상대를 휘감아 그 자리에 묶어 둔다."

msgid "panjandrum_description"
msgstr "어떤 몬스터든 체력에 비례해 피해를 주는 믿음직한 기술."

msgid "peck_description"
msgstr "부리로 날카롭게 쪼아 공격한다."

msgid "peregrine_description"
msgstr "하늘에서 엄청난 속도로 내리꽂아 강력하게 꿰뚫는 공격을 한다."

msgid "perfect_cut_description"
msgstr "수술처럼 정밀하게, 한 치의 오차도 없이 벤다."

msgid "petrify_description"
msgstr "강력한 기운을 내뿜어 상대를 꼼짝 못 하게 만든다."

msgid "phantasmal_force_description"
msgstr "자신의 환영을 만들어 상대를 공격하게 한다."

msgid "piece_of_cake_description"
msgstr "맛있는 케이크를 즐기듯 모든 게 쉬워지는 상태가 되어, 상처를 치유하고 활력을 되찾는다."

msgid "pit_description"
msgstr "상대 발밑에 구덩이를 만들어 떨어뜨리고 피해를 준다."

msgid "platinum_description"
msgstr "몸에 광택 나는 금속이 스며들어 방어가 오르고 피해를 줄 수 있게 된다."

msgid "poison_courtship_description"
msgstr "독이 섞인 유혹의 기운을 내뿜어 상대를 매혹하면서 서서히 독에 빠뜨린다."

msgid "pollen_blast_description"
